{
  // One entry per screenshot. target: "main:<dashboard|allowlist|setup|plugins|settings>" or "plugin:<calendar|goals|insights>".
  // size: window size in DIPs. session: idle (default) | active | pass.
  // steps: { "action": "<UiAction element id>", "args": { form fields } } | { "click": [x, y] } | { "drag": [[x1, y1], [x2, y2]] } | { "wait": ms }.
  // The fake clock is Monday 2026-11-23 10:30; plugins are seeded with a work week of data.
  "shots": [
    { "name": "dashboard-idle", "target": "main:dashboard", "size": [1280, 1080] },
    { "name": "dashboard-session", "target": "main:dashboard", "size": [1280, 1080], "session": "active" },
    { "name": "dashboard-pass", "target": "main:dashboard", "size": [1280, 1080], "session": "pass" },
    { "name": "allowlist", "target": "main:allowlist", "size": [1280, 1080] },
    { "name": "setup", "target": "main:setup", "size": [1280, 1080] },
    { "name": "plugins", "target": "main:plugins", "size": [1280, 1080] },
    { "name": "settings", "target": "main:settings", "size": [1280, 1300] },
    { "name": "calendar-week", "target": "plugin:calendar", "size": [1280, 1500] },
    { "name": "calendar-day", "target": "plugin:calendar", "size": [1280, 1500], "steps": [ { "action": "cal-col-739943" } ] },
    { "name": "calendar-month", "target": "plugin:calendar", "size": [1280, 1300], "steps": [ { "action": "cal-view-month" } ] },
    { "name": "calendar-create", "target": "plugin:calendar", "size": [1280, 1500], "steps": [ { "drag": [[700, 700], [700, 800]] }, { "wait": 300 } ] },
    { "name": "calendar-selected", "target": "plugin:calendar", "size": [1280, 1500], "steps": [ { "action": "cal-ev-4-739942-0" } ] },
    { "name": "calendar-selected-series", "target": "plugin:calendar", "size": [1280, 1500], "steps": [ { "action": "cal-ev-1-739942-0" } ] },
    { "name": "calendar-multiselect", "target": "plugin:calendar", "size": [1280, 1500], "steps": [ { "action": "cal-ev-4-739942-0" }, { "action": "cal-ev-5-739943-0", "kind": "click", "args": { "extend": "true" } } ] },
    { "name": "goals", "target": "plugin:goals", "size": [1280, 1200] },
    { "name": "insights", "target": "plugin:insights", "size": [1280, 1800] }
  ]
}
