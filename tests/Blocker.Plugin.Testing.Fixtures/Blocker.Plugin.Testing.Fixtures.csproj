<Project Sdk="Microsoft.NET.Sdk">
  <!-- Deliberately broken sample test classes for the mini runner. This is a plain class library, not a test
       project, so the xUnit runner never discovers (and fails on) the classes inside it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Blocker.Plugin.Testing.Fixtures</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.extensibility.core" />
    <PackageReference Include="xunit.v3.assert" />
  </ItemGroup>
</Project>
