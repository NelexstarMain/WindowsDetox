<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Blocker.Core\Blocker.Core.csproj" />
    <ProjectReference Include="..\..\src\Blocker.Plugin.Templates\Blocker.Plugin.Templates.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Blocker.Setup is a Windows-only WPF exe; its pure exit-code decision is compiled in so it is tested on Linux too. -->
    <Compile Include="..\..\src\Blocker.Setup\ServiceUninstallCheck.cs" Link="Setup\ServiceUninstallCheck.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="System.IO.Abstractions.TestingHelpers" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
