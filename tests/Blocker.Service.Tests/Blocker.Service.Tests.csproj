<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!-- Windows-only binaries cannot execute on Linux CI; they run in the windows-latest job. -->
    <IsTestProject Condition="!$([MSBuild]::IsOSPlatform('windows'))">false</IsTestProject>
    <IsTestingPlatformApplication Condition="!$([MSBuild]::IsOSPlatform('windows'))">false</IsTestingPlatformApplication>
      <!-- Tests reference the self-contained executables only to call their internals (NETSDK1151). -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Blocker.Service\Blocker.Service.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
