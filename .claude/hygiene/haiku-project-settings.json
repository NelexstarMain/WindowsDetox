{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "disableAllHooks": true,
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/hygiene-report.md)"
    ],
    "deny": [
      "Bash",
      "Write",
      "NotebookEdit",
      "Agent",
      "WebFetch",
      "WebSearch",
      "AskUserQuestion",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Edit(/src/**)",
      "Edit(/tests/**)"
    ]
  }
}
