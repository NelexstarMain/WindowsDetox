    <!-- Chart series palette: accent first, then warm and cool tones that stay distinct on the dark surface. -->
    <SolidColorBrush x:Key="Blocker.Chart.Series1" Color="#7C913D" />
    <SolidColorBrush x:Key="Blocker.Chart.Series2" Color="#F5A524" />
    <SolidColorBrush x:Key="Blocker.Chart.Series3" Color="#60A5FA" />
    <SolidColorBrush x:Key="Blocker.Chart.Series4" Color="#A78BFA" />
    <SolidColorBrush x:Key="Blocker.Chart.Series5" Color="#F87171" />
    <SolidColorBrush x:Key="Blocker.Chart.Series6" Color="#9AA0AE" />

    <!-- ============================== Typography ============================== -->
    <FontFamily x:Key="Blocker.Font.Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Blocker.Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Blocker.Font.Mono">Cascadia Mono, Consolas</FontFamily>

    <!-- ============================== Metrics ============================== -->
    <!-- Spacing steps are multiples of 8 (4 for tight pairs); sections sit 24 apart. -->
    <sys:Double x:Key="Blocker.Space.Tight">4</sys:Double>
    <sys:Double x:Key="Blocker.Space.Gap">8</sys:Double>
    <sys:Double x:Key="Blocker.Space.GapLarge">16</sys:Double>
    <sys:Double x:Key="Blocker.Space.Pad">24</sys:Double>
    <Thickness x:Key="Blocker.Thickness.Gap">8</Thickness>
    <Thickness x:Key="Blocker.Thickness.GapLarge">16</Thickness>
    <Thickness x:Key="Blocker.Thickness.Pad">24</Thickness>
    <Thickness x:Key="Blocker.Thickness.Page">24</Thickness>
    <CornerRadius x:Key="Blocker.Radius.Card">4</CornerRadius>
    <CornerRadius x:Key="Blocker.Radius.Control">4</CornerRadius>
    <CornerRadius x:Key="Blocker.Radius.Pill">20</CornerRadius>

    <!-- ============================== WPF-UI palette overrides ============================== -->
    <Color x:Key="ApplicationBackgroundColor">#0B0C0F</Color>
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource ApplicationBackgroundColor}" />

    <Color x:Key="TextFillColorPrimary">#EEF0F4</Color>
    <Color x:Key="TextFillColorSecondary">#9AA0AE</Color>
    <Color x:Key="TextFillColorTertiary">#5C6270</Color>
    <Color x:Key="TextFillColorDisabled">#4B5160</Color>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource TextFillColorPrimary}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource TextFillColorSecondary}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource TextFillColorTertiary}" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="{StaticResource TextFillColorDisabled}" />

    <Color x:Key="ControlFillColorDefault">#161820</Color>
    <Color x:Key="ControlFillColorSecondary">#1A1D25</Color>
    <Color x:Key="ControlFillColorTertiary">#121419</Color>
    <Color x:Key="ControlFillColorDisabled">#111215</Color>
    <Color x:Key="ControlFillColorInputActive">#0B0C0F</Color>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource ControlFillColorDefault}" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource ControlFillColorSecondary}" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="{StaticResource ControlFillColorTertiary}" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="{StaticResource ControlFillColorDisabled}" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="{StaticResource ControlFillColorInputActive}" />

    <Color x:Key="ControlStrokeColorDefault">#2B303C</Color>
    <Color x:Key="ControlStrokeColorSecondary">#181A21</Color>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource ControlStrokeColorDefault}" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="{StaticResource ControlStrokeColorSecondary}" />

    <Color x:Key="CardBackgroundFillColorDefault">#111215</Color>
    <Color x:Key="CardBackgroundFillColorSecondary">#1A1D25</Color>
    <Color x:Key="CardStrokeColorDefault">#181A21</Color>
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource CardBackgroundFillColorDefault}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource CardBackgroundFillColorSecondary}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource CardStrokeColorDefault}" />

    <Color x:Key="SystemAccentColorPrimary">#5F6F2E</Color>
    <Color x:Key="SystemAccentColorSecondary">#6E8036</Color>
    <Color x:Key="SystemAccentColorTertiary">#7C913D</Color>
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="{StaticResource SystemAccentColorPrimary}" />
    <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="{StaticResource SystemAccentColorSecondary}" />
    <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="{StaticResource SystemAccentColorTertiary}" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#5F6F2E" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#CC5F6F2E" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#995F6F2E" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#BFD0B4" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#F4F7EE" />

    <!-- ============================== Focus ring ============================== -->
    <Style x:Key="Blocker.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3"
                               RadiusX="5"
                               RadiusY="5"
                               SnapsToDevicePixels="True"
                               Stroke="{DynamicResource Blocker.Logo.Brush}"
                               StrokeThickness="1" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== Surfaces ============================== -->
    <Style x:Key="Blocker.CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Blocker.Bg.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Blocker.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Blocker.Radius.Card}" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- A tile nested inside a card: raised instead of a second card. -->
    <Style x:Key="Blocker.InsetBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Blocker.Bg.Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Blocker.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Blocker.Radius.Control}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ============================== Text ============================== -->
    <Style x:Key="Blocker.Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Blocker.Font.Display}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Blocker.Text.Primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Blocker.Text.Display" TargetType="TextBlock" BasedOn="{StaticResource Blocker.Text.Title}">
        <Setter Property="FontSize" Value="32" />
    </Style>

    <Style x:Key="Blocker.Text.Subtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Blocker.Font.Ui}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource Blocker.Text.Secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Blocker.Text.CardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Blocker.Font.Display}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Blocker.Text.Primary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Blocker.Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Blocker.Font.Ui}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Blocker.Text.Primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Blocker.Text.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Blocker.Font.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Blocker.Text.Secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Blocker.Text.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Blocker.Font.Mono}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Blocker.Text.Primary}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <Style x:Key="Blocker.Text.MonoSmall" TargetType="TextBlock" BasedOn="{StaticResource Blocker.Text.Mono}">
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Short codes and small timers: break-glass code, toast countdown. -->
    <Style x:Key="Blocker.Text.Code" TargetType="TextBlock" BasedOn="{StaticResource Blocker.Text.Mono}">
        <Setter Property="FontSize" Value="20" />
    </Style>

    <Style x:Key="Blocker.Text.MonoLarge" TargetType="TextBlock" BasedOn="{StaticResource Blocker.Text.Mono}">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="Light" />
    </Style>

    <!-- Display face so zeros stay open (0, not a slashed zero). -->
    <Style x:Key="Blocker.Text.Clock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Blocker.Font.Display}" />
        <Setter Property="FontSize" Value="74" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="Foreground" Value="{DynamicResource Blocker.Text.Primary}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- ============================== Buttons ============================== -->
    <!-- Hover and pressed states are a white overlay so every variant shares one template. -->
    <Style x:Key="Blocker.Button.Base" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource Blocker.Font.Ui}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Blocker.Text.Primary}" />
        <Setter Property="Background" Value="#161820" />
        <Setter Property="BorderBrush" Value="#2B303C" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Blocker.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Blocker.Radius.Control}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="Overlay"
                                    Background="White"
                                    CornerRadius="{StaticResource Blocker.Radius.Control}"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.16" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Blocker.Button.Primary" TargetType="Button" BasedOn="{StaticResource Blocker.Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Blocker.Accent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Blocker.Text.OnAccent}" />
    </Style>

    <Style x:Key="Blocker.Button.Secondary" TargetType="Button" BasedOn="{StaticResource Blocker.Button.Base}" />

    <Style x:Key="Blocker.Button.Warning" TargetType="Button" BasedOn="{StaticResource Blocker.Button.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Blocker.Warning}" />
    </Style>

    <!-- Pill variants: the shared template with the pill corner radius. -->
    <Style x:Key="Blocker.Button.SecondaryPill" TargetType="Button" BasedOn="{StaticResource Blocker.Button.Base}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Blocker.Radius.Pill}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="Overlay"
                                    Background="White"
                                    CornerRadius="{StaticResource Blocker.Radius.Pill}"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.16" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Blocker.Button.GhostPill" TargetType="Button" BasedOn="{StaticResource Blocker.Button.SecondaryPill}">
        <Setter Property="Background" Value="#121419" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Blocker.Text.Secondary}" />
    </Style>

    <Style x:Key="Blocker.Button.Subtle" TargetType="Button" BasedOn="{StaticResource Blocker.Button.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Blocker.Text.Secondary}" />
    </Style>

    <!-- ============================== Dividers, info badge, tooltip ============================== -->
    <Style x:Key="Blocker.SectionDivider" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Blocker.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Small square "?" that carries an explanation as a tooltip (set ToolTip with Blocker.InfoTip.ToolTip). -->
    <Style x:Key="Blocker.InfoBadge" TargetType="ContentControl">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Help" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border x:Name="Box"
                            Background="#121419"
                            BorderBrush="#2B303C"
                            BorderThickness="1"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                        <TextBlock Text="?"
                                   FontFamily="{DynamicResource Blocker.Font.Ui}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Blocker.Text.Secondary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Blocker.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Blocker.InfoTip.ToolTip" TargetType="ToolTip">
        <Setter Property="MaxWidth" Value="280" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Foreground" Value="{DynamicResource Blocker.Text.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Blocker.Font.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource Blocker.Bg.Card}"
                            BorderBrush="{DynamicResource Blocker.Border.Strong}"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== Square toggle switch ============================== -->
    <Style TargetType="ui:ToggleSwitch">
        <Setter Property="Foreground" Value="{DynamicResource Blocker.Text.Primary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Blocker.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:ToggleSwitch">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Track"
                                Width="42"
                                Height="22"
                                CornerRadius="5"
                                Background="#161820"
                                BorderBrush="#2B303C"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <Border x:Name="Thumb"
                                    Width="14"
                                    Height="14"
                                    CornerRadius="3"
                                    Background="{DynamicResource Blocker.Text.Secondary}"
                                    HorizontalAlignment="Left"
                                    Margin="3,0,0,0" />
                        </Border>
                        <ContentPresenter Margin="12,0,0,0"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          Content="{TemplateBinding Content}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Blocker.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Blocker.Accent}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                            <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource Blocker.Text.OnAccent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Blocker.Border.Strong}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== Navigation item ============================== -->
    <!-- WPF-UI's NavigationView content panel: transparent so the #0B0C0F canvas and the faint logo watermark show through. -->
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />

    <!-- Keyed and set explicitly on each item: NavigationView brings its own item style, which would win over an implicit one. -->
    <Style x:Key="Blocker.NavItem" TargetType="ui:NavigationViewItem">
        <Setter Property="Foreground" Value="{DynamicResource Blocker.Text.Secondary}" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Blocker.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:NavigationViewItem">
                    <Border x:Name="Item"
                            Padding="10,8"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter x:Name="IconHost"
                                              Content="{TemplateBinding Icon}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              VerticalAlignment="Center" />
                            <ContentPresenter Margin="12,0,0,0"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              Content="{TemplateBinding Content}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Item" Property="Background" Value="#0F1116" />
                            <Setter Property="Foreground" Value="{DynamicResource Blocker.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsActive" Value="True">
                            <Setter TargetName="Item" Property="Background" Value="#14171E" />
                            <Setter TargetName="Item" Property="BorderBrush" Value="#222632" />
                            <Setter TargetName="IconHost" Property="TextElement.Foreground" Value="{DynamicResource Blocker.Logo.Brush}" />
                            <Setter Property="Foreground" Value="{DynamicResource Blocker.Text.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
