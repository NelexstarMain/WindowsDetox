<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Dark" />
        <ui:ControlsDictionary />
    </ResourceDictionary.MergedDictionaries>

    <!-- ============================== Palette ============================== -->
    <Color x:Key="Blocker.Bg.Base.Color">#111215</Color>
    <Color x:Key="Blocker.Bg.Card.Color">#181A1F</Color>
    <Color x:Key="Blocker.Bg.Raised.Color">#20232A</Color>
    <Color x:Key="Blocker.Border.Subtle.Color">#12FFFFFF</Color>
    <Color x:Key="Blocker.Border.Strong.Color">#24FFFFFF</Color>
    <Color x:Key="Blocker.Text.Primary.Color">#F4F4F5</Color>
    <Color x:Key="Blocker.Text.Secondary.Color">#9CA3AF</Color>
    <Color x:Key="Blocker.Text.Muted.Color">#6B7280</Color>
    <Color x:Key="Blocker.Text.OnAccent.Color">#06201B</Color>
    <Color x:Key="Blocker.Accent.Color">#3DD9C1</Color>
    <Color x:Key="Blocker.Accent.Soft.Color">#2E3DD9C1</Color>
    <Color x:Key="Blocker.Warning.Color">#F5A524</Color>
    <Color x:Key="Blocker.Warning.Soft.Color">#2EF5A524</Color>
    <Color x:Key="Blocker.Danger.Color">#F87171</Color>
    <Color x:Key="Blocker.Danger.Soft.Color">#2EF87171</Color>
    <Color x:Key="Blocker.Success.Color">#34D399</Color>
    <Color x:Key="Blocker.Success.Soft.Color">#2E34D399</Color>

    <SolidColorBrush x:Key="Blocker.Bg.Base" Color="{StaticResource Blocker.Bg.Base.Color}" />
    <SolidColorBrush x:Key="Blocker.Bg.Card" Color="{StaticResource Blocker.Bg.Card.Color}" />
    <SolidColorBrush x:Key="Blocker.Bg.Raised" Color="{StaticResource Blocker.Bg.Raised.Color}" />
    <SolidColorBrush x:Key="Blocker.Border.Subtle" Color="{StaticResource Blocker.Border.Subtle.Color}" />
    <SolidColorBrush x:Key="Blocker.Border.Strong" Color="{StaticResource Blocker.Border.Strong.Color}" />
    <SolidColorBrush x:Key="Blocker.Text.Primary" Color="{StaticResource Blocker.Text.Primary.Color}" />
    <SolidColorBrush x:Key="Blocker.Text.Secondary" Color="{StaticResource Blocker.Text.Secondary.Color}" />
    <SolidColorBrush x:Key="Blocker.Text.Muted" Color="{StaticResource Blocker.Text.Muted.Color}" />
    <SolidColorBrush x:Key="Blocker.Text.OnAccent" Color="{StaticResource Blocker.Text.OnAccent.Color}" />
    <SolidColorBrush x:Key="Blocker.Accent" Color="{StaticResource Blocker.Accent.Color}" />
    <SolidColorBrush x:Key="Blocker.Accent.Soft" Color="{StaticResource Blocker.Accent.Soft.Color}" />
    <SolidColorBrush x:Key="Blocker.Warning" Color="{StaticResource Blocker.Warning.Color}" />
    <SolidColorBrush x:Key="Blocker.Warning.Soft" Color="{StaticResource Blocker.Warning.Soft.Color}" />
    <SolidColorBrush x:Key="Blocker.Danger" Color="{StaticResource Blocker.Danger.Color}" />
    <SolidColorBrush x:Key="Blocker.Danger.Soft" Color="{StaticResource Blocker.Danger.Soft.Color}" />
    <SolidColorBrush x:Key="Blocker.Success" Color="{StaticResource Blocker.Success.Color}" />
    <SolidColorBrush x:Key="Blocker.Success.Soft" Color="{StaticResource Blocker.Success.Soft.Color}" />

    <!-- Chart series palette: accent first, then warm and cool tones that stay distinct on the dark surface. -->
    <SolidColorBrush x:Key="Blocker.Chart.Series1" Color="#3DD9C1" />
    <SolidColorBrush x:Key="Blocker.Chart.Series2" Color="#F5A524" />
    <SolidColorBrush x:Key="Blocker.Chart.Series3" Color="#60A5FA" />
    <SolidColorBrush x:Key="Blocker.Chart.Series4" Color="#A78BFA" />
    <SolidColorBrush x:Key="Blocker.Chart.Series5" Color="#F87171" />
    <SolidColorBrush x:Key="Blocker.Chart.Series6" Color="#94A3B8" />

    <!-- ============================== Typography ============================== -->
    <FontFamily x:Key="Blocker.Font.Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Blocker.Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Blocker.Font.Mono">Cascadia Mono, Consolas</FontFamily>

    <!-- ============================== Metrics ============================== -->
    <sys:Double x:Key="Blocker.Space.Pad">20</sys:Double>
    <sys:Double x:Key="Blocker.Space.Gap">12</sys:Double>
    <sys:Double x:Key="Blocker.Space.GapLarge">16</sys:Double>
    <Thickness x:Key="Blocker.Thickness.Pad">20</Thickness>
    <Thickness x:Key="Blocker.Thickness.Gap">12</Thickness>
    <Thickness x:Key="Blocker.Thickness.GapLarge">16</Thickness>
    <CornerRadius x:Key="Blocker.Radius.Card">12</CornerRadius>
    <CornerRadius x:Key="Blocker.Radius.Control">8</CornerRadius>

    <!-- ============================== Blueprint grid ============================== -->
    <!-- 96 px tile = 4 x 4 cells of 24 px. Minor lines 3.5 %, every fourth line 6 %. Lines are 1 px, aliased for crispness. -->
    <DrawingBrush x:Key="Blocker.Brush.BlueprintGrid"
                  TileMode="Tile"
                  Stretch="None"
                  ViewportUnits="Absolute"
                  ViewboxUnits="Absolute"
                  Viewport="0,0,96,96"
                  Viewbox="0,0,96,96"
                  RenderOptions.EdgeMode="Aliased">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#09FFFFFF">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup FillRule="Nonzero">
                            <RectangleGeometry Rect="24,0,1,96" />
                            <RectangleGeometry Rect="48,0,1,96" />
                            <RectangleGeometry Rect="72,0,1,96" />
                            <RectangleGeometry Rect="0,24,96,1" />
                            <RectangleGeometry Rect="0,48,96,1" />
                            <RectangleGeometry Rect="0,72,96,1" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#0FFFFFFF">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup FillRule="Nonzero">
                            <RectangleGeometry Rect="0,0,1,96" />
                            <RectangleGeometry Rect="0,0,96,1" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ============================== WPF-UI palette overrides ============================== -->
    <Color x:Key="ApplicationBackgroundColor">#111215</Color>
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource ApplicationBackgroundColor}" />

    <Color x:Key="TextFillColorPrimary">#F4F4F5</Color>
    <Color x:Key="TextFillColorSecondary">#9CA3AF</Color>
    <Color x:Key="TextFillColorTertiary">#6B7280</Color>
    <Color x:Key="TextFillColorDisabled">#4B5160</Color>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource TextFillColorPrimary}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource TextFillColorSecondary}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource TextFillColorTertiary}" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="{StaticResource TextFillColorDisabled}" />

    <Color x:Key="ControlFillColorDefault">#20232A</Color>
    <Color x:Key="ControlFillColorSecondary">#262A32</Color>
    <Color x:Key="ControlFillColorTertiary">#1C1F25</Color>
    <Color x:Key="ControlFillColorDisabled">#1A1C21</Color>
    <Color x:Key="ControlFillColorInputActive">#14161A</Color>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource ControlFillColorDefault}" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource ControlFillColorSecondary}" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="{StaticResource ControlFillColorTertiary}" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="{StaticResource ControlFillColorDisabled}" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="{StaticResource ControlFillColorInputActive}" />

    <Color x:Key="ControlStrokeColorDefault">#24FFFFFF</Color>
    <Color x:Key="ControlStrokeColorSecondary">#12FFFFFF</Color>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource ControlStrokeColorDefault}" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="{StaticResource ControlStrokeColorSecondary}" />

    <Color x:Key="CardBackgroundFillColorDefault">#181A1F</Color>
    <Color x:Key="CardBackgroundFillColorSecondary">#20232A</Color>
    <Color x:Key="CardStrokeColorDefault">#12FFFFFF</Color>
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource CardBackgroundFillColorDefault}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource CardBackgroundFillColorSecondary}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource CardStrokeColorDefault}" />

    <Color x:Key="SystemAccentColorPrimary">#3DD9C1</Color>
    <Color x:Key="SystemAccentColorSecondary">#3DD9C1</Color>
    <Color x:Key="SystemAccentColorTertiary">#3DD9C1</Color>
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="{StaticResource SystemAccentColorPrimary}" />
    <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="{StaticResource SystemAccentColorSecondary}" />
    <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="{StaticResource SystemAccentColorTertiary}" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#3DD9C1" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#CC3DD9C1" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#993DD9C1" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#3DD9C1" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#06201B" />

    <!-- ============================== Focus ring ============================== -->
    <Style x:Key="Blocker.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3"
                               RadiusX="10"
                               RadiusY="10"
                               SnapsToDevicePixels="True"
                               Stroke="{DynamicResource Blocker.Accent}"
                               StrokeThickness="1" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== Surfaces ============================== -->
    <Style x:Key="Blocker.CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Blocker.Bg.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Blocker.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Blocker.Radius.Card}" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- A tile nested inside a card: raised instead of a second card, and not part of the metaball field. -->
    <Style x:Key="Blocker.InsetBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Blocker.Bg.Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Blocker.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Blocker.Radius.Control}" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ============================== Text ============================== -->
    <Style x:Key="Blocker.Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Blocker.Font.Display}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Blocker.Text.Primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Blocker.Text.Subtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Blocker.Font.Ui}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource Blocker.Text.Secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Blocker.Text.CardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Blocker.Font.Display}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Blocker.Text.Primary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Blocker.Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Blocker.Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Blocker.Text.Primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Blocker.Text.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Blocker.Font.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Blocker.Text.Secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Blocker.Text.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Blocker.Font.Mono}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Blocker.Text.Primary}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <Style x:Key="Blocker.Text.Clock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Blocker.Font.Mono}" />
        <Setter Property="FontSize" Value="56" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="Foreground" Value="{DynamicResource Blocker.Text.Primary}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- ============================== Buttons ============================== -->
    <!-- Hover and pressed states are a white overlay so every variant shares one template. -->
    <Style x:Key="Blocker.Button.Base" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource Blocker.Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Blocker.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Blocker.Bg.Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Blocker.Border.Strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Blocker.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Blocker.Radius.Control}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="Overlay"
                                    Background="White"
                                    CornerRadius="{StaticResource Blocker.Radius.Control}"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.16" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Blocker.Button.Primary" TargetType="Button" BasedOn="{StaticResource Blocker.Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Blocker.Accent}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Blocker.Text.OnAccent}" />
    </Style>

    <Style x:Key="Blocker.Button.Secondary" TargetType="Button" BasedOn="{StaticResource Blocker.Button.Base}" />

    <Style x:Key="Blocker.Button.Warning" TargetType="Button" BasedOn="{StaticResource Blocker.Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Blocker.Warning.Soft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Blocker.Warning}" />
        <Setter Property="Foreground" Value="{DynamicResource Blocker.Warning}" />
    </Style>

    <Style x:Key="Blocker.Button.Subtle" TargetType="Button" BasedOn="{StaticResource Blocker.Button.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Blocker.Text.Secondary}" />
    </Style>
</ResourceDictionary>
