<Project Sdk="Microsoft.NET.Sdk">
  <!-- SKELETON ONLY: minimal stand-in so Blocker.UI and Blocker.Stub compile. The real shared controls library replaces this project at merge. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Blocker.UI.Controls</RootNamespace>
    <AssemblyName>Blocker.UI.Controls</AssemblyName>
    <Description>SKELETON stand-in for the shared WPF controls library (theme, metaballs, UiNode renderer, dialog and snackbar services).</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Blocker.UI.SDK\Blocker.UI.SDK.csproj" />
  </ItemGroup>
</Project>
