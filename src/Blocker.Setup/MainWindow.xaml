<Window x:Class="Blocker.Setup.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Detox Setup" Width="560" Height="380" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource Canvas}" Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14">
    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Path Data="M 0 0 Z" x:Name="Watermark" Fill="{StaticResource Sage}" Opacity="0.025" Grid.RowSpan="3" Width="300" Height="300" Stretch="Uniform"
              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-80,-90" IsHitTestVisible="False" />

        <Border BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1" Padding="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Path x:Name="Logo" Fill="{StaticResource Sage}" Width="26" Height="26" Stretch="Uniform" VerticalAlignment="Center" />
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Windows Detox" FontSize="20" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI" />
                    <TextBlock x:Name="VersionText" Foreground="{StaticResource TextSecondary}" FontSize="12" FontFamily="Cascadia Mono, Consolas" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="Body" Margin="0,8,0,0" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="20" />
            <ProgressBar x:Name="Progress" Margin="0,20,0,0" Height="4" IsIndeterminate="True" Visibility="Collapsed"
                         Foreground="#7C913D" Background="#16181F" BorderThickness="0" />
            <TextBlock x:Name="Status" Margin="0,10,0,0" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SecondaryButton" Style="{StaticResource PillButton}" Content="Cancel" Click="OnSecondary" />
            <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" IsDefault="True" Click="OnPrimary" />
        </StackPanel>
    </Grid>
</Window>
