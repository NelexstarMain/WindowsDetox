<Application x:Class="Blocker.Stub.App"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Blocker.Stub"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Blocker.UI.Controls;component/Themes/Blocker.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisible" />
            <local:ExecutableIconConverter x:Key="ExeIcon" />
            <local:HasTextToVisibilityConverter x:Key="HasText" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
