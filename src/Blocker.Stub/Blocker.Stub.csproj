<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Blocker.Stub</RootNamespace>
    <AssemblyName>Blocker.Stub</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Block screen shown instead of a blocked application: reason, remaining session time, emergency exit and plugin content.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Blocker.UI.Controls\Blocker.UI.Controls.csproj" />
    <ProjectReference Include="..\Blocker.Contracts\Blocker.Contracts.csproj" />
    <ProjectReference Include="..\Blocker.Core\Blocker.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <!-- Small pure helpers shared with Blocker.UI by linking, so both executables format time identically. -->
    <Compile Include="..\Blocker.UI\ViewModels\DurationFormat.cs" Link="Shared\DurationFormat.cs" />
    <Compile Include="..\Blocker.UI\ViewModels\SessionTimeline.cs" Link="Shared\SessionTimeline.cs" />
  </ItemGroup>
</Project>
