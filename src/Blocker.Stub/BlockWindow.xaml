<Window x:Class="Blocker.Stub.BlockWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rd="clr-namespace:Blocker.UI.Controls.Rendering;assembly=Blocker.UI.Controls"
        xmlns:local="clr-namespace:Blocker.Stub"
        Title="Blocked by WindowsDetox" Width="560" Height="420"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource Blocker.Bg.Canvas}"
        Foreground="{DynamicResource Blocker.Text.Primary}"
        BorderBrush="#3C4132" BorderThickness="1">
    <Grid>
        <Path Data="{StaticResource Blocker.Logo.Geometry}" Fill="{DynamicResource Blocker.Logo.Brush}" Opacity="0.025"
              Width="360" Height="360" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Margin="0,0,-60,-60" IsHitTestVisible="False" />
        <Border Margin="24" ClipToBounds="False">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Image Width="40" Height="40" Margin="0,0,14,0" Source="{Binding BlockedPath, Converter={StaticResource ExeIcon}}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{DynamicResource Blocker.Text.Title}" FontSize="22" Text="{Binding AppName}" TextTrimming="CharacterEllipsis" MaxWidth="400" />
                        <TextBlock Style="{DynamicResource Blocker.Text.Caption}" Text="is blocked right now" />
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,16,0,12" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource Blocker.Text.Body}" Text="{Binding ReasonText}" />

                        <StackPanel Margin="0,16,0,0" Visibility="{Binding SessionIsRunning, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Style="{DynamicResource Blocker.Text.Clock}" FontSize="44" Text="{Binding ClockText}"
                                       AutomationProperties.Name="Time remaining in session" />
                            <TextBlock Style="{DynamicResource Blocker.Text.Caption}" Text="until the session ends" />
                        </StackPanel>

                        <TextBlock Style="{DynamicResource Blocker.Text.Body}" Margin="0,16,0,0" Text="{Binding UnreachableMessage}"
                                   Visibility="{Binding IsUnreachable, Converter={StaticResource BoolToVisible}}" />

                        <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding Contributions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <rd:UiNodeView Margin="0,0,0,8" Node="{Binding Node}"
                                                   local:UiNodeCommand.Contribution="{Binding}"
                                                   local:UiNodeCommand.Command="{Binding DataContext.SendActionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2">
                    <TextBlock Style="{DynamicResource Blocker.Text.Caption}" Margin="0,0,0,8" Text="{Binding StatusMessage}"
                               Visibility="{Binding StatusMessage, Converter={StaticResource HasText}}" />

                    <!-- Inline confirmation instead of a dialog: the window is tiny and modal dialogs would hide the clock. -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Style="{DynamicResource Blocker.Text.Body}" VerticalAlignment="Center" Margin="0,0,12,0"
                                   Text="Pause blocking and use one pass?" />
                        <Button Style="{DynamicResource Blocker.Button.Warning}" Command="{Binding ConfirmEmergencyExitCommand}" Content="Use pass" />
                        <Button Margin="8,0,0,0" Style="{DynamicResource Blocker.Button.Subtle}" Command="{Binding CancelEmergencyExitCommand}" Content="Keep blocking" />
                    </StackPanel>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConfirming}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" HorizontalAlignment="Left" Style="{DynamicResource Blocker.Button.Warning}"
                                Command="{Binding UseEmergencyExitCommand}" Content="{Binding EmergencyLabel}" />
                        <Button Grid.Column="1" Style="{DynamicResource Blocker.Button.SecondaryPill}"
                                Command="{Binding CloseCommand}" Content="Close" IsDefault="True" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
