<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cv="clr-namespace:Blocker.UI.Converters">

    <cv:BoolToVisibilityConverter x:Key="BoolToVisible" />
    <cv:BoolToVisibilityConverter x:Key="BoolToCollapsed" Invert="True" />
    <cv:NullOrEmptyToVisibilityConverter x:Key="HasTextToVisible" />
    <cv:NullOrEmptyToVisibilityConverter x:Key="HasTextToCollapsed" Invert="True" />
    <cv:PngBytesToImageConverter x:Key="PngToImage" />

    <!-- Small borderless pill label used for state, source badges and capabilities. -->
    <Style x:Key="App.Chip" TargetType="Border">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="CornerRadius" Value="{StaticResource Blocker.Radius.Pill}" />
        <Setter Property="Background" Value="#181A15" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="0,0,8,8" />
    </Style>

    <Style x:Key="App.ChipText" TargetType="TextBlock" BasedOn="{StaticResource Blocker.Text.Caption}">
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="Foreground" Value="{DynamicResource Blocker.Text.Secondary}" />
    </Style>

    <!-- Selectable pill for the duration presets. -->
    <Style x:Key="App.PillItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Foreground" Value="{DynamicResource Blocker.Text.Secondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Blocker.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Pill" Padding="16,8" CornerRadius="18" BorderThickness="1"
                            Background="#181A15"
                            BorderBrush="Transparent">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="#1F221B" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="#252C15" />
                            <Setter TargetName="Pill" Property="BorderBrush" Value="#5F6F2E" />
                            <Setter Property="Foreground" Value="#DCE6D3" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Blocker.Logo.Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="App.PillList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource App.PillItem}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
</ResourceDictionary>
