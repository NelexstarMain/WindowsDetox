<Page x:Class="Blocker.UI.Views.AllowlistPage"
      ScrollViewer.CanContentScroll="True"
             x:ClassModifier="internal"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Blocker.UI.ViewModels"
      Title="Allowlist" Background="Transparent">
    <Grid Margin="{StaticResource Blocker.Thickness.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{DynamicResource Blocker.Text.Title}" Text="Allowlist" Margin="0,0,0,24" />

        <Border Grid.Row="1" Margin="0,0,0,16" Padding="16,8" CornerRadius="4" BorderThickness="1"
                Background="{DynamicResource Blocker.Warning.Soft}" BorderBrush="{DynamicResource Blocker.Warning}"
                Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisible}}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="LockClosed24" Foreground="{DynamicResource Blocker.Warning}" Margin="0,0,8,0" />
                <TextBlock Style="{DynamicResource Blocker.Text.Body}" Foreground="{DynamicResource Blocker.Text.Primary}"
                           Text="{Binding LockMessage}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" MaxWidth="400" />
            </Grid.ColumnDefinitions>

            <!-- Apps -->
            <Grid Grid.Column="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{DynamicResource Blocker.Text.CardTitle}" Text="Apps" VerticalAlignment="Center" />
                                <ContentControl Style="{DynamicResource Blocker.InfoBadge}" Margin="8,-1,0,0">
                                    <ContentControl.ToolTip>
                                        <ToolTip Style="{DynamicResource Blocker.InfoTip.ToolTip}" Content="Apps you can keep using during a session." />
                                    </ContentControl.ToolTip>
                                </ContentControl>
                            </StackPanel>
                            <TextBlock Style="{DynamicResource Blocker.Text.Caption}" Margin="0,4,0,0" Text="{Binding SelectionSummary}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{DynamicResource Blocker.Button.Subtle}" Command="{Binding ScanCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,8,0" />
                                <TextBlock Text="Rescan" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,16,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" PlaceholderText="Search apps by name or path"
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="Search apps" />
                        <Button Grid.Column="1" Margin="8,0,0,0" Style="{DynamicResource Blocker.Button.Secondary}"
                                Command="{Binding SelectAllFilteredCommand}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Select all shown" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AreAllFilteredSelected}" Value="True">
                                                <Setter Property="Text" Value="Clear all shown" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="2">
                        <!-- Tiles toggle IsSelected on the view model directly (code-behind); the ListBox selection stays unused because a
                             two-way container binding would deselect apps whenever the search filter rebuilds the list. -->
                        <ListBox ItemsSource="{Binding FilteredApps}" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single"
                                 AutomationProperties.Name="Apps">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="0,0,8,8" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="FocusVisualStyle" Value="{StaticResource Blocker.FocusVisual}" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                                    <Setter Property="IsEnabled" Value="{Binding DataContext.CanEditSelection, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnTileMouseDown" />
                                    <EventSetter Event="KeyDown" Handler="OnTileKeyDown" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Tile" Width="104" Height="104" Padding="6,10,6,8" CornerRadius="{StaticResource Blocker.Radius.Card}"
                                                        BorderThickness="1" BorderBrush="Transparent" Background="Transparent" SnapsToDevicePixels="True">
                                                    <Grid>
                                                        <ContentPresenter />
                                                        <Border x:Name="Check" Width="18" Height="18" CornerRadius="9" Visibility="Hidden"
                                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-2,0"
                                                                Background="{DynamicResource Blocker.Accent}">
                                                            <ui:SymbolIcon Symbol="Checkmark12" FontSize="11" Foreground="{DynamicResource Blocker.Text.OnAccent}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Blocker.Border.Subtle}" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Blocker.Accent.Soft}" />
                                                        <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Blocker.Accent}" />
                                                        <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="Tile" Property="Opacity" Value="0.6" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AppEntryViewModel}">
                                    <Grid>
                                        <Grid.ToolTip>
                                            <ToolTip Style="{DynamicResource Blocker.InfoTip.ToolTip}">
                                                <StackPanel MaxWidth="360">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Subtitle}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                               Visibility="{Binding Subtitle, Converter={StaticResource HasTextToVisible}}" />
                                                    <ItemsControl ItemsSource="{Binding Badges}" Margin="0,6,0,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Style="{StaticResource App.Chip}" Margin="0,0,4,0" Padding="8,2">
                                                                    <TextBlock Text="{Binding}" Style="{StaticResource App.ChipText}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </ToolTip>
                                        </Grid.ToolTip>
                                        <Ellipse Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,-2,0,0"
                                                 Fill="{DynamicResource Blocker.Success}"
                                                 Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisible}}" />
                                        <StackPanel HorizontalAlignment="Center">
                                            <Image Width="44" Height="44" HorizontalAlignment="Center"
                                                   Source="{Binding IconPng, Converter={StaticResource PngToImage}}" />
                                            <TextBlock Text="{Binding DisplayName}" Style="{DynamicResource Blocker.Text.Caption}"
                                                       Foreground="{DynamicResource Blocker.Text.Primary}" Margin="0,8,0,0"
                                                       TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                       MaxHeight="34" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding HasNoApps, Converter={StaticResource BoolToVisible}}">
                            <ui:ProgressRing IsIndeterminate="True" Width="32" Height="32"
                                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisible}}" />
                            <TextBlock Style="{DynamicResource Blocker.Text.Body}" Margin="0,16,0,0" TextAlignment="Center"
                                       Text="Scanning installed apps..."
                                       Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisible}}" />
                            <TextBlock Style="{DynamicResource Blocker.Text.Body}" Margin="0,16,0,0" TextAlignment="Center"
                                       Text="No apps to show. Clear the search or rescan."
                                       Visibility="{Binding IsScanning, Converter={StaticResource BoolToCollapsed}}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <Border Grid.Column="1" Width="1" Margin="24,0" Background="{DynamicResource Blocker.Border.Subtle}" />

            <!-- Domains -->
            <Grid Grid.Column="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource Blocker.Text.CardTitle}" Text="Domains" VerticalAlignment="Center" />
                        <ContentControl Style="{DynamicResource Blocker.InfoBadge}" Margin="8,-1,0,0">
                            <ContentControl.ToolTip>
                                <ToolTip Style="{DynamicResource Blocker.InfoTip.ToolTip}" Content="Websites you can keep using during a session. Use *.example.com for subdomains." />
                            </ContentControl.ToolTip>
                        </ContentControl>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox PlaceholderText="example.com or *.example.com" FontFamily="{DynamicResource Blocker.Font.Mono}"
                                    Text="{Binding NewDomain, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding CanEditSelection}"
                                    AutomationProperties.Name="Domain to allow">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddDomainCommand}" />
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>
                        <Button Grid.Column="1" Margin="8,0,0,0" Style="{DynamicResource Blocker.Button.Primary}"
                                Command="{Binding AddDomainCommand}" Content="Add" />
                    </Grid>
                    <TextBlock Grid.Row="2" Margin="0,8,0,0" Text="{Binding DomainHint}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Blocker.Text.Caption}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDomainError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Blocker.Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl Grid.Row="3" Margin="0,16,0,0" ItemsSource="{Binding Domains}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding}" Style="{DynamicResource Blocker.Text.Mono}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="1" Style="{DynamicResource Blocker.Button.Subtle}" Padding="8,4"
                                            Command="{Binding DataContext.RemoveDomainCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="Remove domain">
                                        <ui:SymbolIcon Symbol="Dismiss24" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Grid.Row="3" Margin="0,16,0,0" Text="No websites yet. Add the domains you still need.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Blocker.Text.Caption}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Domains.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Row="4" Margin="0,16,0,0" HorizontalAlignment="Stretch" Style="{DynamicResource Blocker.Button.Primary}"
                            Command="{Binding SaveCommand}" Content="Save allowlist" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
