<Page x:Class="Blocker.UI.Views.SetupPage"
             x:ClassModifier="internal"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:mb="clr-namespace:Blocker.UI.Controls.Metaballs;assembly=Blocker.UI.Controls"
      Title="Session setup" Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="{StaticResource Blocker.Thickness.Page}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Style="{DynamicResource Blocker.Text.Title}" Text="Session setup" Margin="0,0,0,24" />

                <Border Style="{DynamicResource Blocker.CardBorder}" mb:Metaball.IsBody="True">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource Blocker.Text.Subtitle}" Text="How long" />
                        <ListBox Margin="0,16,0,0" Style="{StaticResource App.PillList}"
                                 ItemsSource="{Binding DurationOptions}" SelectedItem="{Binding SelectedDuration}"
                                 DisplayMemberPath="Label" AutomationProperties.Name="Session length" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                    Visibility="{Binding IsCustomDuration, Converter={StaticResource BoolToVisible}}">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Blocker.Text.Caption}" Text="Hours" Margin="0,0,0,4" />
                                <ui:NumberBox Width="120" Minimum="0" Maximum="720" SmallChange="1" MaxDecimalPlaces="0"
                                              Value="{Binding CustomHours, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="16,0,0,0">
                                <TextBlock Style="{DynamicResource Blocker.Text.Caption}" Text="Minutes" Margin="0,0,0,4" />
                                <ui:NumberBox Width="120" Minimum="0" Maximum="59" SmallChange="5" MaxDecimalPlaces="0"
                                              Value="{Binding CustomMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Margin="0,8,0,0" Style="{DynamicResource Blocker.Text.Caption}"
                                   Foreground="{DynamicResource Blocker.Danger}" Text="{Binding DurationError}"
                                   Visibility="{Binding DurationError, Converter={StaticResource HasTextToVisible}}" />
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource Blocker.CardBorder}" mb:Metaball.IsBody="True" Margin="0,24,0,0">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource Blocker.Text.Subtitle}" Text="Emergency passes" />
                        <TextBlock Style="{DynamicResource Blocker.Text.Body}" Margin="0,4,0,0"
                                   Text="A pass pauses blocking for a short time. Set none for a session that only the break-glass code can end early." />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Blocker.Text.Caption}" Text="Passes per day" Margin="0,0,0,4" />
                                <ui:NumberBox Width="140" Minimum="0" Maximum="10" SmallChange="1" MaxDecimalPlaces="0"
                                              Value="{Binding PassesPerDay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="16,0,0,0">
                                <TextBlock Style="{DynamicResource Blocker.Text.Caption}" Text="Minutes per pass" Margin="0,0,0,4" />
                                <ui:NumberBox Width="140" Minimum="1" Maximum="30" SmallChange="1" MaxDecimalPlaces="0"
                                              Value="{Binding PassMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>
                        <ui:ToggleSwitch Margin="0,16,0,0" Content="Carry unused passes over to the next day"
                                         IsChecked="{Binding CarryOverUnusedPasses, Mode=TwoWay}" />
                        <TextBlock Margin="0,8,0,0" Style="{DynamicResource Blocker.Text.Caption}"
                                   Foreground="{DynamicResource Blocker.Danger}" Text="{Binding PassError}"
                                   Visibility="{Binding PassError, Converter={StaticResource HasTextToVisible}}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Summary and the single primary action. -->
            <Border Grid.Column="2" Style="{DynamicResource Blocker.CardBorder}" mb:Metaball.IsBody="True" VerticalAlignment="Top" Margin="0,48,0,0">
                <StackPanel>
                    <TextBlock Style="{DynamicResource Blocker.Text.Subtitle}" Text="Summary" />
                    <TextBlock Style="{DynamicResource Blocker.Text.MonoLarge}" Margin="0,16,0,0" Text="{Binding DurationText}" />
                    <TextBlock Style="{DynamicResource Blocker.Text.Caption}" Margin="0,4,0,16" Text="{Binding EndsAtText, StringFormat='Ends: {0}'}"
                               Visibility="{Binding EndsAtText, Converter={StaticResource HasTextToVisible}}" />
                    <TextBlock Style="{DynamicResource Blocker.Text.Body}" Text="{Binding AppsText}" Margin="0,4,0,0" />
                    <TextBlock Style="{DynamicResource Blocker.Text.Body}" Text="{Binding DomainsText}" Margin="0,4,0,0" />
                    <TextBlock Style="{DynamicResource Blocker.Text.Body}" Text="{Binding PassesText}" Margin="0,4,0,0" />

                    <Button Margin="0,24,0,0" HorizontalAlignment="Stretch" Style="{DynamicResource Blocker.Button.Primary}"
                            Command="{Binding StartSessionCommand}" Content="Start session" />
                    <TextBlock Style="{DynamicResource Blocker.Text.Caption}" Margin="0,8,0,0" Text="{Binding StartBlockedReason}"
                               Visibility="{Binding StartBlockedReason, Converter={StaticResource HasTextToVisible}}" />
                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding StartErrors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{DynamicResource Blocker.Text.Caption}"
                                           Foreground="{DynamicResource Blocker.Danger}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
