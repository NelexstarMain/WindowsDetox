<UserControl x:Class="Blocker.UI.Views.Dialogs.InstallReportContent"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Blocker.UI.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisible" />
    </UserControl.Resources>
    <ScrollViewer MaxHeight="460" MinWidth="460" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Style="{DynamicResource Blocker.Text.Subtitle}" Text="Stages" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding Stages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:InstallStage}">
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <ui:SymbolIcon x:Name="Glyph" Symbol="Dismiss24" Margin="0,0,10,0" FontSize="16"
                                           Foreground="{DynamicResource Blocker.Text.Muted}" />
                            <TextBlock x:Name="Label" Text="{Binding Name}" Style="{DynamicResource Blocker.Text.Body}" />
                            <TextBlock x:Name="Result" Margin="10,0,0,0" Style="{DynamicResource Blocker.Text.Caption}" VerticalAlignment="Center" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Passed">
                                <Setter TargetName="Glyph" Property="Symbol" Value="CheckmarkCircle24" />
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Blocker.Success}" />
                                <Setter TargetName="Result" Property="Text" Value="Passed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                <Setter TargetName="Glyph" Property="Symbol" Value="ErrorCircle24" />
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Blocker.Danger}" />
                                <Setter TargetName="Result" Property="Text" Value="Failed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="NotRun">
                                <Setter TargetName="Result" Property="Text" Value="Not run" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisible}}" Margin="0,16,0,0">
                <TextBlock Style="{DynamicResource Blocker.Text.Subtitle}" Text="Problems" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Errors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Margin="0,3" TextWrapping="Wrap"
                                       FontFamily="{DynamicResource Blocker.Font.Mono}" FontSize="12"
                                       Foreground="{DynamicResource Blocker.Danger}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Visibility="{Binding HasTests, Converter={StaticResource BoolToVisible}}" Margin="0,16,0,0">
                <TextBlock Style="{DynamicResource Blocker.Text.Subtitle}" Text="Plugin tests" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Tests}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:InstallTestResult}">
                            <StackPanel Margin="0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Verdict" Text="Fail" Width="40" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Blocker.Danger}"
                                               FontFamily="{DynamicResource Blocker.Font.Mono}" />
                                    <TextBlock Text="{Binding Name}" Style="{DynamicResource Blocker.Text.Body}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Detail}" Margin="40,2,0,0" Style="{DynamicResource Blocker.Text.Caption}" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Passed}" Value="True">
                                    <Setter TargetName="Verdict" Property="Text" Value="Pass" />
                                    <Setter TargetName="Verdict" Property="Foreground" Value="{DynamicResource Blocker.Success}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
