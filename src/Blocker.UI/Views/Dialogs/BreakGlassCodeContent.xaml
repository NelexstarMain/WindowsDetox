<UserControl x:Class="Blocker.UI.Views.Dialogs.BreakGlassCodeContent"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel MinWidth="420">
        <TextBlock Style="{DynamicResource Blocker.Text.Body}"
                   Text="This code ends the session early and unlocks everything. It is shown only now and cannot be recovered later. Write it down or store it in a password manager." />
        <Border Margin="0,16,0,0" Padding="16" CornerRadius="8"
                Background="{DynamicResource Blocker.Bg.Raised}"
                BorderBrush="{DynamicResource Blocker.Border.Strong}" BorderThickness="1">
            <TextBox Text="{Binding Code, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                     FontFamily="{DynamicResource Blocker.Font.Mono}" FontSize="20"
                     Foreground="{DynamicResource Blocker.Text.Primary}"
                     AutomationProperties.Name="Break-glass code" />
        </Border>
        <Button Margin="0,16,0,0" HorizontalAlignment="Left"
                Style="{DynamicResource Blocker.Button.Secondary}"
                Command="{Binding CopyCommand}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Copy24" Margin="0,0,8,0" />
                <TextBlock Text="{Binding CopyLabel}" />
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
