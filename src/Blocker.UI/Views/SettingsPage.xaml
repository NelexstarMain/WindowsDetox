<Page x:Class="Blocker.UI.Views.SettingsPage"
      ScrollViewer.CanContentScroll="True"
             x:ClassModifier="internal"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:rd="clr-namespace:Blocker.UI.Controls.Rendering;assembly=Blocker.UI.Controls"
      xmlns:bh="clr-namespace:Blocker.UI.Behaviors"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Settings" Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource Blocker.Thickness.Page}" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Style="{DynamicResource Blocker.Text.Title}" Text="Settings" />
            <TextBlock Style="{DynamicResource Blocker.Text.Subtitle}" Margin="0,4,0,24" Text="Preferences for the app and its plugins." />

            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource Blocker.SectionDivider}" Padding="0,0,0,24" Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Blocker.Text.CardTitle}" Text="{Binding Title}" Margin="0,0,0,16" />
                                <rd:UiNodeView Node="{Binding Node}"
                                               bh:UiNodeActions.Contribution="{Binding}"
                                               bh:UiNodeActions.Command="{Binding DataContext.SendSectionActionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{DynamicResource Blocker.SectionDivider}" Padding="0,0,0,24" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Style="{DynamicResource Blocker.Text.CardTitle}" Text="Block notice" Margin="0,0,0,16" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{DynamicResource Blocker.Text.Body}" Text="Show when an app is blocked" />
                            <TextBlock Style="{DynamicResource Blocker.Text.Caption}" Text="A small card in the corner that closes by itself" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Show when an app is blocked"
                                         IsChecked="{Binding ShowBlockNotice, Mode=TwoWay}" IsEnabled="{Binding CanChangeBlockNotice}" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Style="{DynamicResource Blocker.Text.Caption}"
                       Text="Blocking is decided by the Blocker service. This app only shows state and sends your requests." />
            <TextBlock Style="{DynamicResource Blocker.Text.MonoSmall}" Margin="0,8,0,0" Foreground="{DynamicResource Blocker.Text.Muted}" Text="{Binding VersionText}" />
        </StackPanel>
    </ScrollViewer>
</Page>
