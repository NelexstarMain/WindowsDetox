<Page x:Class="Blocker.UI.Views.DashboardPage"
             x:ClassModifier="internal"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:rd="clr-namespace:Blocker.UI.Controls.Rendering;assembly=Blocker.UI.Controls"
      xmlns:bh="clr-namespace:Blocker.UI.Behaviors"
      Title="Session" Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource Blocker.Thickness.Page}">
            <Border Style="{DynamicResource Blocker.SectionDivider}" Padding="0,0,0,16" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{DynamicResource Blocker.Text.Title}" Text="Session" VerticalAlignment="Center" />
                    <ContentControl Style="{DynamicResource Blocker.InfoBadge}" Margin="8,-1,0,0">
                        <ContentControl.ToolTip>
                            <ToolTip Style="{DynamicResource Blocker.InfoTip.ToolTip}"
                                     Content="Only allowlisted apps and websites stay open until the timer reaches zero." />
                        </ContentControl.ToolTip>
                    </ContentControl>
                </StackPanel>
            </Border>

            <!-- Idle: one action, one shortcut. -->
            <StackPanel HorizontalAlignment="Center" Margin="0,32,0,24"
                        Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisible}}">
                <TextBlock Style="{DynamicResource Blocker.Text.Clock}" Text="{Binding ClockText}" HorizontalAlignment="Center" Margin="0,0,0,24" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{DynamicResource Blocker.Button.Primary}" Command="{Binding StartSessionCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 0,0 L 8,4.5 L 0,9 Z" Fill="{DynamicResource Blocker.Text.OnAccent}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="Start session" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Margin="12,0,0,0" Style="{DynamicResource Blocker.Button.SecondaryPill}"
                            Command="{Binding OpenAllowlistCommand}" Content="Allowlist" />
                </StackPanel>
            </StackPanel>

            <!-- Running: clock, progress, pass countdown and the exits. -->
            <StackPanel HorizontalAlignment="Center" Margin="0,32,0,24"
                        Visibility="{Binding IsSessionRunning, Converter={StaticResource BoolToVisible}}">
                <TextBlock Style="{DynamicResource Blocker.Text.Clock}" Text="{Binding ClockText}" HorizontalAlignment="Center"
                           AutomationProperties.Name="Time remaining in session" />
                <ProgressBar Width="460" Height="4" Margin="0,20,0,28" Minimum="0" Maximum="1"
                             Value="{Binding ProgressRatio, Mode=OneWay}" Background="#16181F"
                             Foreground="{DynamicResource Blocker.Accent.Bar}" BorderThickness="0" />

                <Border Margin="0,0,0,24" Padding="14,10" CornerRadius="4" BorderThickness="1" HorizontalAlignment="Center"
                        Visibility="{Binding IsPassActive, Converter={StaticResource BoolToVisible}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Blocker.Bg.Raised}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Blocker.Border.Strong}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPassWarning}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Blocker.Warning.Soft}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Blocker.Warning}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding PassClockText}" Style="{DynamicResource Blocker.Text.Mono}" FontSize="16"
                                   VerticalAlignment="Center" AutomationProperties.Name="Emergency pass time remaining" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Blocker.Text.Caption}">
                                    <Setter Property="Text" Value="Blocking is paused." />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPassWarning}" Value="True">
                                            <Setter Property="Text" Value="Blocking resumes in under a minute." />
                                            <Setter Property="Foreground" Value="{DynamicResource Blocker.Warning}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{DynamicResource Blocker.Button.Warning}" Command="{Binding UseEmergencyPassCommand}" Content="Emergency exit" />
                    <StackPanel Orientation="Horizontal" Margin="18,0" VerticalAlignment="Center">
                        <TextBlock Style="{DynamicResource Blocker.Text.Body}" VerticalAlignment="Center">
                            <Run Text="{Binding PassesLeftText, Mode=OneWay}" />
                            <Run Text="{Binding PassLengthText, Mode=OneWay}" />
                        </TextBlock>
                        <ContentControl Style="{DynamicResource Blocker.InfoBadge}" Margin="7,-1,0,0">
                            <ContentControl.ToolTip>
                                <ToolTip Style="{DynamicResource Blocker.InfoTip.ToolTip}"
                                         Content="An emergency pass pauses blocking for a short time. Blocking resumes automatically when it expires." />
                            </ContentControl.ToolTip>
                        </ContentControl>
                    </StackPanel>
                    <Button Style="{DynamicResource Blocker.Button.GhostPill}" Command="{Binding EnterBreakGlassCodeCommand}" Content="Break-glass code" />
                </StackPanel>
                <TextBlock Style="{DynamicResource Blocker.Text.Caption}" Margin="0,12,0,0" HorizontalAlignment="Center"
                           TextAlignment="Center" Text="{Binding EmergencyHint}"
                           Visibility="{Binding EmergencyHint, Converter={StaticResource HasTextToVisible}}" />
            </StackPanel>

            <!-- Plugin widgets. -->
            <TextBlock Style="{DynamicResource Blocker.Text.Caption}" Margin="0,16,0,0" Text="{Binding WidgetsError}"
                       Visibility="{Binding WidgetsError, Converter={StaticResource HasTextToVisible}}" />
            <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding Widgets}"
                          Visibility="{Binding HasWidgets, Converter={StaticResource BoolToVisible}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <rd:UiNodeView Margin="0,0,16,16" MinWidth="280" Node="{Binding Node}"
                                       bh:UiNodeActions.Contribution="{Binding}"
                                       bh:UiNodeActions.Command="{Binding DataContext.SendWidgetActionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
