<Page x:Class="Blocker.UI.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:mb="clr-namespace:Blocker.UI.Controls.Metaballs;assembly=Blocker.UI.Controls"
      xmlns:rd="clr-namespace:Blocker.UI.Controls.Rendering;assembly=Blocker.UI.Controls"
      xmlns:bh="clr-namespace:Blocker.UI.Behaviors"
      Title="Session" Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,28">
            <TextBlock Style="{DynamicResource Blocker.Text.Title}" Text="Session" Margin="0,0,0,16" />

            <!-- Idle: one invitation, one action. -->
            <Border Style="{DynamicResource Blocker.CardBorder}" mb:Metaball.IsBody="True" Padding="32"
                    Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisible}}">
                <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock Style="{DynamicResource Blocker.Text.Title}" FontSize="32" Text="Start a detox session" />
                    <TextBlock Style="{DynamicResource Blocker.Text.Body}" Margin="0,12,0,0"
                               Text="Pick the apps and sites you still need, choose how long, and Blocker closes everything else until time is up." />
                    <Button Margin="0,24,0,0" HorizontalAlignment="Left" Style="{DynamicResource Blocker.Button.Primary}"
                            Command="{Binding StartSessionCommand}" Content="Set up a session" />
                </StackPanel>
            </Border>

            <!-- Running: clock on the left, emergency pass on the right. -->
            <Grid Visibility="{Binding IsSessionRunning, Converter={StaticResource BoolToVisible}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{DynamicResource Blocker.CardBorder}" mb:Metaball.IsBody="True" Padding="28">
                    <StackPanel>
                        <Border HorizontalAlignment="Left" Margin="0,0,0,8">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource App.Chip}">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Blocker.Accent}" />
                                    <Setter Property="Background" Value="{DynamicResource Blocker.Accent.Soft}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPassActive}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Blocker.Warning}" />
                                            <Setter Property="Background" Value="{DynamicResource Blocker.Warning.Soft}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource Blocker.Accent}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPassActive}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource Blocker.Warning}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding StateLabel}" Style="{StaticResource App.ChipText}"
                                           Foreground="{DynamicResource Blocker.Text.Primary}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{DynamicResource Blocker.Text.Clock}" Text="{Binding ClockText}"
                                   AutomationProperties.Name="Time remaining in session" />
                        <TextBlock Style="{DynamicResource Blocker.Text.Caption}" Text="until the session ends" Margin="4,0,0,0" />
                        <Button Margin="0,20,0,0" HorizontalAlignment="Left" Style="{DynamicResource Blocker.Button.Subtle}"
                                Command="{Binding EnterBreakGlassCodeCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Key24" Margin="0,0,8,0" />
                                <TextBlock Text="Enter break-glass code" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{DynamicResource Blocker.CardBorder}" mb:Metaball.IsBody="True">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource Blocker.Text.Subtitle}" Text="Emergency pass" />
                        <TextBlock Style="{DynamicResource Blocker.Text.Body}" Margin="0,4,0,0">
                            <Run Text="{Binding PassesLeftText, Mode=OneWay}" />
                            <Run Text="{Binding PassLengthText, Mode=OneWay}" />
                        </TextBlock>

                        <!-- A pass is running: its own countdown, amber in the last minute. -->
                        <Border Margin="0,16,0,0" Padding="14,12" CornerRadius="8" BorderThickness="1"
                                Visibility="{Binding IsPassActive, Converter={StaticResource BoolToVisible}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Blocker.Bg.Raised}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Blocker.Border.Subtle}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPassWarning}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Blocker.Warning.Soft}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Blocker.Warning}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding PassClockText}" Style="{DynamicResource Blocker.Text.Mono}" FontSize="32"
                                           Foreground="{DynamicResource Blocker.Warning}"
                                           AutomationProperties.Name="Emergency pass time remaining" />
                                <TextBlock Style="{DynamicResource Blocker.Text.Caption}" Margin="0,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Blocker.Text.Caption}">
                                            <Setter Property="Text" Value="Blocking is paused. It resumes when this reaches zero." />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPassWarning}" Value="True">
                                                    <Setter Property="Text" Value="Blocking resumes in under a minute. Save your work now." />
                                                    <Setter Property="Foreground" Value="{DynamicResource Blocker.Warning}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Button Margin="0,16,0,0" HorizontalAlignment="Stretch" Style="{DynamicResource Blocker.Button.Warning}"
                                Command="{Binding UseEmergencyPassCommand}" Content="Emergency exit" />
                        <TextBlock Style="{DynamicResource Blocker.Text.Caption}" Margin="0,8,0,0" Text="{Binding EmergencyHint}"
                                   Visibility="{Binding EmergencyHint, Converter={StaticResource HasTextToVisible}}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Plugin widgets. -->
            <TextBlock Style="{DynamicResource Blocker.Text.Caption}" Margin="0,16,0,0" Text="{Binding WidgetsError}"
                       Visibility="{Binding WidgetsError, Converter={StaticResource HasTextToVisible}}" />
            <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding Widgets}"
                          Visibility="{Binding HasWidgets, Converter={StaticResource BoolToVisible}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <rd:UiNodeView Margin="0,0,16,16" MinWidth="280" Node="{Binding Node}"
                                       bh:UiNodeActions.Contribution="{Binding}"
                                       bh:UiNodeActions.Command="{Binding DataContext.SendWidgetActionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
