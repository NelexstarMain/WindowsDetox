<Page x:Class="Blocker.UI.Views.DashboardPage"
             x:ClassModifier="internal"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:rd="clr-namespace:Blocker.UI.Controls.Rendering;assembly=Blocker.UI.Controls"
      xmlns:bh="clr-namespace:Blocker.UI.Behaviors"
      xmlns:v="clr-namespace:Blocker.UI.Views"
      xmlns:vm="clr-namespace:Blocker.UI.ViewModels"
      Title="Session" Background="Transparent">
    <Page.Resources>
        <!-- What a widget shows: the plugin's icon and name (the only identity), then its content drawn flat on the host's surface. -->
        <DataTemplate x:Key="App.WidgetFace" DataType="{x:Type vm:ContributionViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Height="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center">
                        <Path Stretch="Uniform" Fill="{DynamicResource Blocker.Text.Secondary}" Data="{Binding Icon}" Opacity="0.85"
                              Visibility="{Binding Icon, Converter={StaticResource HasTextToVisible}}" />
                        <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="14" Foreground="{DynamicResource Blocker.Text.Secondary}"
                                       Visibility="{Binding Icon, Converter={StaticResource HasTextToCollapsed}}" />
                    </Grid>
                    <TextBlock Grid.Column="1" Style="{DynamicResource Blocker.Text.Caption}" VerticalAlignment="Center"
                               Text="{Binding Title}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               AutomationProperties.Name="{Binding Title, StringFormat='Open {0}'}" />
                </Grid>
                <Grid Grid.Row="1" Margin="0,8,0,0" ClipToBounds="True">
                    <rd:UiNodeView Node="{Binding Node}" IsFlat="True" VerticalAlignment="Top"
                                   bh:UiNodeActions.Contribution="{Binding}"
                                   bh:UiNodeActions.Command="{Binding DataContext.SendWidgetActionCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- Round remove button at a widget's top-right corner in edit mode. -->
        <Style x:Key="App.WidgetRemoveButton" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="{DynamicResource Blocker.Text.Secondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Blocker.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Disc" CornerRadius="12" BorderThickness="1" SnapsToDevicePixels="True"
                                Background="{DynamicResource Blocker.Bg.Base}" BorderBrush="{DynamicResource Blocker.Border.Strong}">
                            <ui:SymbolIcon x:Name="Glyph" Symbol="Dismiss12" FontSize="11" Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Disc" Property="Background" Value="{DynamicResource Blocker.Danger.Soft}" />
                                <Setter TargetName="Disc" Property="BorderBrush" Value="{DynamicResource Blocker.Danger}" />
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Blocker.Danger}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="{StaticResource Blocker.Thickness.Page}">
                <Border Style="{DynamicResource Blocker.SectionDivider}" Padding="0,0,0,16" Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource Blocker.Text.Title}" Text="Session" VerticalAlignment="Center" />
                        <ContentControl Style="{DynamicResource Blocker.InfoBadge}" Margin="8,-1,0,0">
                            <ContentControl.ToolTip>
                                <ToolTip Style="{DynamicResource Blocker.InfoTip.ToolTip}"
                                         Content="Only allowlisted apps and websites stay open until the timer reaches zero." />
                            </ContentControl.ToolTip>
                        </ContentControl>
                    </StackPanel>
                </Border>

                <!-- Idle: one action, one shortcut. -->
                <StackPanel HorizontalAlignment="Center" Margin="0,32,0,24"
                            Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisible}}">
                    <TextBlock Style="{DynamicResource Blocker.Text.Clock}" Text="{Binding ClockText}" HorizontalAlignment="Center" Margin="0,0,0,24" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{DynamicResource Blocker.Button.Primary}" Command="{Binding StartSessionCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 0,0 L 8,4.5 L 0,9 Z" Fill="{DynamicResource Blocker.Text.OnAccent}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Start session" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Margin="12,0,0,0" Style="{DynamicResource Blocker.Button.SecondaryPill}"
                                Command="{Binding OpenAllowlistCommand}" Content="Allowlist" />
                    </StackPanel>
                </StackPanel>

                <!-- Running: clock, progress, pass countdown and the exits. -->
                <StackPanel HorizontalAlignment="Center" Margin="0,32,0,24"
                            Visibility="{Binding IsSessionRunning, Converter={StaticResource BoolToVisible}}">
                    <TextBlock Style="{DynamicResource Blocker.Text.Clock}" Text="{Binding ClockText}" HorizontalAlignment="Center"
                               AutomationProperties.Name="Time remaining in session" />
                    <ProgressBar Width="460" Height="4" Margin="0,20,0,28" Minimum="0" Maximum="1"
                                 Value="{Binding ProgressRatio, Mode=OneWay}" Background="#16181F"
                                 Foreground="{DynamicResource Blocker.Accent.Bar}" BorderThickness="0" />

                    <Border Margin="0,0,0,24" Padding="14,10" CornerRadius="4" BorderThickness="1" HorizontalAlignment="Center"
                            Visibility="{Binding IsPassActive, Converter={StaticResource BoolToVisible}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Blocker.Bg.Raised}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Blocker.Border.Strong}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPassWarning}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Blocker.Warning.Soft}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Blocker.Warning}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding PassClockText}" Style="{DynamicResource Blocker.Text.Mono}" FontSize="16"
                                       VerticalAlignment="Center" AutomationProperties.Name="Emergency pass time remaining" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Blocker.Text.Caption}">
                                        <Setter Property="Text" Value="Blocking is paused." />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPassWarning}" Value="True">
                                                <Setter Property="Text" Value="Blocking resumes in under a minute." />
                                                <Setter Property="Foreground" Value="{DynamicResource Blocker.Warning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{DynamicResource Blocker.Button.Warning}" Command="{Binding UseEmergencyPassCommand}" Content="Emergency exit" />
                        <StackPanel Orientation="Horizontal" Margin="18,0" VerticalAlignment="Center">
                            <TextBlock Style="{DynamicResource Blocker.Text.Body}" VerticalAlignment="Center">
                                <Run Text="{Binding PassesLeftText, Mode=OneWay}" />
                                <Run Text="{Binding PassLengthText, Mode=OneWay}" />
                            </TextBlock>
                            <ContentControl Style="{DynamicResource Blocker.InfoBadge}" Margin="7,-1,0,0">
                                <ContentControl.ToolTip>
                                    <ToolTip Style="{DynamicResource Blocker.InfoTip.ToolTip}"
                                             Content="An emergency pass pauses blocking for a short time. Blocking resumes automatically when it expires." />
                                </ContentControl.ToolTip>
                            </ContentControl>
                        </StackPanel>
                        <Button Style="{DynamicResource Blocker.Button.GhostPill}" Command="{Binding EnterBreakGlassCodeCommand}" Content="Break-glass code" />
                    </StackPanel>
                    <TextBlock Style="{DynamicResource Blocker.Text.Caption}" Margin="0,12,0,0" HorizontalAlignment="Center"
                               TextAlignment="Center" Text="{Binding EmergencyHint}"
                               Visibility="{Binding EmergencyHint, Converter={StaticResource HasTextToVisible}}" />
                </StackPanel>

                <!-- Plugin widgets the user chose. -->
                <Grid Margin="0,24,0,16" Visibility="{Binding Board.HasAvailable, Converter={StaticResource BoolToVisible}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{DynamicResource Blocker.Text.CardTitle}" Text="Widgets" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{DynamicResource Blocker.Button.Subtle}" Padding="10,0" MinWidth="40"
                                Command="{Binding Board.Picker.OpenCommand}" ToolTip="Add widgets"
                                AutomationProperties.Name="Add widgets">
                            <ui:SymbolIcon Symbol="Add24" />
                        </Button>
                        <Button Style="{DynamicResource Blocker.Button.Subtle}" Padding="10,0" Margin="4,0,0,0"
                                Command="{Binding Board.ToggleEditCommand}" ToolTip="Rearrange or remove widgets"
                                AutomationProperties.Name="Edit widgets">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,8,0">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Symbol" Value="Edit24" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Board.IsEditing}" Value="True">
                                                    <Setter Property="Symbol" Value="Checkmark24" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Edit" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Board.IsEditing}" Value="True">
                                                    <Setter Property="Text" Value="Done" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <TextBlock Style="{DynamicResource Blocker.Text.Caption}" Margin="0,0,0,16" Text="{Binding WidgetsError}"
                           Visibility="{Binding WidgetsError, Converter={StaticResource HasTextToVisible}}" />
                <TextBlock Style="{DynamicResource Blocker.Text.Caption}" Margin="0,0,0,16" Foreground="{DynamicResource Blocker.Warning}"
                           Text="{Binding Board.LayoutError}"
                           Visibility="{Binding Board.LayoutError, Converter={StaticResource HasTextToVisible}}" />

                <TextBlock Style="{DynamicResource Blocker.Text.Caption}" Margin="0,-8,0,16"
                           Text="Drag a widget to move it. Drag its corner to resize. Press Esc to cancel."
                           Visibility="{Binding Board.IsEditing, Converter={StaticResource BoolToVisible}}" />

                <!-- Empty board: one dashed tile, the size of a single cell. -->
                <v:WidgetGridPanel Visibility="{Binding Board.ShowEmptyState, Converter={StaticResource BoolToVisible}}">
                    <Button Style="{DynamicResource Blocker.Button.Subtle}" Padding="0" Background="Transparent"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            Command="{Binding Board.Picker.OpenCommand}" AutomationProperties.Name="Add first widget">
                        <Grid>
                            <Rectangle Stroke="{DynamicResource Blocker.Border.Strong}" StrokeThickness="1" StrokeDashArray="4 4" RadiusX="12" RadiusY="12" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="Add24" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <TextBlock Style="{DynamicResource Blocker.Text.Caption}" Text="Add widgets" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </v:WidgetGridPanel>

                <ItemsControl x:Name="BoardItems" ItemsSource="{Binding Board.Items}" Focusable="False"
                              bh:WidgetBoardInteraction.Board="{Binding Board}"
                              Visibility="{Binding Board.HasItems, Converter={StaticResource BoolToVisible}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <v:WidgetGridPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="v:WidgetGridPanel.ColumnSpan" Value="{Binding Cols}" />
                            <Setter Property="v:WidgetGridPanel.RowSpan" Value="{Binding Rows}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- One rounded surface per widget. Tapping it opens the plugin; edit mode swaps that for drag, resize and remove. -->
                            <Grid x:Name="Cell" Background="Transparent" SnapsToDevicePixels="True">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter Property="Cursor" Value="SizeAll" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <Border CornerRadius="12" Background="{DynamicResource Blocker.Bg.Raised}" />

                                <!-- Hover outline: fades in and out instead of switching. -->
                                <Border CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource Blocker.Border.Strong}"
                                        IsHitTestVisible="False" Opacity="0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver, ElementName=Cell}" Value="True" />
                                                        <Condition Binding="{Binding IsEditing}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <MultiDataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Blocker.Motion.Fast}"
                                                                                 EasingFunction="{StaticResource Blocker.Motion.EaseOut}" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.EnterActions>
                                                    <MultiDataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Blocker.Motion.Fast}"
                                                                                 EasingFunction="{StaticResource Blocker.Motion.EaseIn}" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.ExitActions>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <ContentControl Margin="15,13,15,0" ClipToBounds="True" Focusable="False"
                                                Content="{Binding Contribution}" ContentTemplate="{StaticResource App.WidgetFace}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <Setter Property="IsHitTestVisible" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>

                                <!-- Content taller than the cell is clipped; the bottom edge fades out. -->
                                <Border VerticalAlignment="Bottom" Height="24" Margin="1" CornerRadius="0,0,11,11" IsHitTestVisible="False"
                                        Background="{DynamicResource Blocker.Bg.Raised}">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0" />
                                            <GradientStop Color="#00000000" Offset="0.45" />
                                            <GradientStop Color="#FF000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>

                                <!-- Edit mode: dashed outline, remove button and resize handle fade in; they leave through a shorter fade and cannot be
                                     clicked while they do. -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Setter Property="IsHitTestVisible" Value="False" />
                                            <Setter Property="Opacity" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="IsHitTestVisible" Value="True" />
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="{StaticResource Blocker.Motion.Normal}"
                                                                                 EasingFunction="{StaticResource Blocker.Motion.EaseOut}" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Blocker.Motion.Exit}"
                                                                                 EasingFunction="{StaticResource Blocker.Motion.EaseIn}" />
                                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="{StaticResource Blocker.Motion.Exit}"
                                                                                               FillBehavior="Stop">
                                                                    <DiscreteObjectKeyFrame KeyTime="0%" Value="{x:Static Visibility.Visible}" />
                                                                    <DiscreteObjectKeyFrame KeyTime="100%" Value="{x:Static Visibility.Collapsed}" />
                                                                </ObjectAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Rectangle Stroke="{DynamicResource Blocker.Accent.Bar}" StrokeThickness="1" StrokeDashArray="4 3"
                                               RadiusX="12" RadiusY="12" Margin="0.5" IsHitTestVisible="False" />
                                    <Button Style="{StaticResource App.WidgetRemoveButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                                            Command="{Binding DataContext.Board.RemoveCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}" ToolTip="Remove widget"
                                            AutomationProperties.Name="{Binding Title, StringFormat='Remove {0}'}" />
                                    <!-- A button only so that it is exposed to UI Automation under its name; the board's pointer handling takes the press. -->
                                    <Button bh:WidgetBoardInteraction.IsResizeHandle="True" Width="30" Height="30" Padding="0" Focusable="False"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"
                                            ToolTip="Drag to resize" AutomationProperties.Name="Resize widget">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Path Data="M 0,10 L 10,0 M 4,10 L 10,4 M 8,10 L 10,8" Stroke="{DynamicResource Blocker.Accent.Bar}" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10"
                                              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8" IsHitTestVisible="False" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Widget picker: a slim rail on the right edge lists the plugins; pointing at one opens a flyout beside it with its widgets. The board
             stays visible under a light scrim so what gets added can be seen. -->
        <Grid x:Name="PickerOverlay" DataContext="{Binding Board.Picker}" KeyboardNavigation.TabNavigation="Cycle">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                            <Setter Property="IsHitTestVisible" Value="True" />
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <!-- Stays visible (but no longer clickable) while the rail leaves, then falls back to Collapsed. -->
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="{StaticResource Blocker.Motion.Exit}"
                                                                       FillBehavior="Stop">
                                            <DiscreteObjectKeyFrame KeyTime="0%" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="100%" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
            </Grid.InputBindings>

            <!-- Scrim: black fading between 0 and 0.2 (Motion.ScrimOpacity); a click anywhere on the page closes the rail. -->
            <Border Background="Black" Opacity="0" Cursor="Arrow">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseCommand}" />
                </Border.InputBindings>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="0.2" Duration="{StaticResource Blocker.Motion.Normal}"
                                                             EasingFunction="{StaticResource Blocker.Motion.EaseOut}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Blocker.Motion.Exit}"
                                                             EasingFunction="{StaticResource Blocker.Motion.EaseIn}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <!-- The rail: close button on top, then one item per plugin (icon above its name). In: a short slide from the edge while fading in. -->
            <Border x:Name="PickerRail" Width="84" HorizontalAlignment="Right" Opacity="0" SnapsToDevicePixels="True"
                    Background="{DynamicResource Blocker.Bg.Base}" BorderBrush="{DynamicResource Blocker.Border.Subtle}" BorderThickness="1,0,0,0">
                <Border.RenderTransform>
                    <TranslateTransform />
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             From="{StaticResource Blocker.Motion.PanelOffset}" To="0" Duration="{StaticResource Blocker.Motion.Normal}"
                                                             EasingFunction="{StaticResource Blocker.Motion.EaseOut}" />
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="{StaticResource Blocker.Motion.Normal}"
                                                             EasingFunction="{StaticResource Blocker.Motion.EaseOut}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="{StaticResource Blocker.Motion.PanelOffset}" Duration="{StaticResource Blocker.Motion.Exit}"
                                                             EasingFunction="{StaticResource Blocker.Motion.EaseIn}" />
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Blocker.Motion.Exit}"
                                                             EasingFunction="{StaticResource Blocker.Motion.EaseIn}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel LastChildFill="True">
                    <Button x:Name="PickerClose" DockPanel.Dock="Top" Style="{DynamicResource Blocker.Button.Subtle}" Width="32" Height="32" MinHeight="0" Padding="0"
                            HorizontalAlignment="Center" Margin="0,12,0,8" Command="{Binding CloseCommand}" ToolTip="Close (Esc)"
                            AutomationProperties.Name="Close widget picker">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
                    </Button>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="6,0,6,4" Padding="2,8" MinHeight="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                                            Command="{Binding DataContext.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title, StringFormat='Widgets from {0}'}"
                                            MouseEnter="OnRailItemEnter" MouseLeave="OnRailItemLeave" GotKeyboardFocus="OnRailItemFocus">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource Blocker.Button.Subtle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Blocker.Bg.Raised}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel>
                                            <Grid Width="24" Height="24" HorizontalAlignment="Center">
                                                <Path Stretch="Uniform" Fill="{DynamicResource Blocker.Text.Secondary}" Data="{Binding Icon}" Opacity="0.85"
                                                      Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisible}}" />
                                                <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="22" Foreground="{DynamicResource Blocker.Text.Secondary}"
                                                               Visibility="{Binding HasIcon, Converter={StaticResource BoolToCollapsed}}" />
                                            </Grid>
                                            <TextBlock Style="{DynamicResource Blocker.Text.Caption}" FontSize="11" Margin="0,6,0,0" MaxHeight="30"
                                                       TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Flyout left of the rail, level with the item it belongs to: the plugin's widgets as live previews. Fades in with a short slide. -->
            <Border x:Name="PickerFlyout" Width="288" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,92,0" Padding="16,14,16,4"
                    CornerRadius="12" BorderThickness="1" Opacity="0" SnapsToDevicePixels="True"
                    Background="{DynamicResource Blocker.Bg.Raised}" BorderBrush="{DynamicResource Blocker.Border.Subtle}"
                    MouseEnter="OnFlyoutEnter" MouseLeave="OnFlyoutLeave" SizeChanged="OnFlyoutSizeChanged">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.4" Color="Black" />
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform />
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="IsHitTestVisible" Value="False" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasFlyout}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="IsHitTestVisible" Value="True" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             From="{StaticResource Blocker.Motion.FlyoutOffset}" To="0" Duration="{StaticResource Blocker.Motion.Fast}"
                                                             EasingFunction="{StaticResource Blocker.Motion.EaseOut}" />
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="{StaticResource Blocker.Motion.Fast}"
                                                             EasingFunction="{StaticResource Blocker.Motion.EaseOut}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="{StaticResource Blocker.Motion.FlyoutOffset}" Duration="{StaticResource Blocker.Motion.Fast}"
                                                             EasingFunction="{StaticResource Blocker.Motion.EaseIn}" />
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Blocker.Motion.Fast}"
                                                             EasingFunction="{StaticResource Blocker.Motion.EaseIn}" />
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="{StaticResource Blocker.Motion.Fast}"
                                                                           FillBehavior="Stop">
                                                <DiscreteObjectKeyFrame KeyTime="0%" Value="{x:Static Visibility.Visible}" />
                                                <DiscreteObjectKeyFrame KeyTime="100%" Value="{x:Static Visibility.Collapsed}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel DataContext="{Binding FlyoutGroup}" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Style="{DynamicResource Blocker.Text.Subtitle}" Margin="0,0,0,12" Text="{Binding Title}"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Entries}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- A banner: the widget as it will look on the board, its name and span. Click to add it; the rail stays open. -->
                                    <Button Margin="0,0,0,12" Padding="8" MinHeight="0" HorizontalContentAlignment="Left" VerticalContentAlignment="Top"
                                            Style="{DynamicResource Blocker.Button.Subtle}"
                                            Command="{Binding DataContext.AddCommand, ElementName=PickerOverlay}" CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding Title, StringFormat='Add {0}'}">
                                        <StackPanel Width="{Binding PreviewWidth}">
                                            <Border Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}" CornerRadius="8" BorderThickness="1"
                                                    Background="{DynamicResource Blocker.Bg.Base}" BorderBrush="{DynamicResource Blocker.Border.Subtle}"
                                                    ClipToBounds="True">
                                                <Viewbox Stretch="Uniform">
                                                    <Grid Width="{Binding SlotWidth}" Height="{Binding SlotHeight}" IsHitTestVisible="False">
                                                        <ContentControl Margin="15,13,15,0" ClipToBounds="True" Focusable="False"
                                                                        Content="{Binding Contribution}" ContentTemplate="{StaticResource App.WidgetFace}" />
                                                    </Grid>
                                                </Viewbox>
                                            </Border>
                                            <Grid Margin="2,8,2,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Style="{DynamicResource Blocker.Text.Body}" FontWeight="SemiBold" Text="{Binding Title}"
                                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                    <TextBlock Style="{DynamicResource Blocker.Text.Caption}" Text="{Binding SpanLabel}" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Style="{StaticResource App.Chip}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding IsAdded, Converter={StaticResource BoolToVisible}}">
                                                    <TextBlock Style="{StaticResource App.ChipText}" Text="Added" />
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
