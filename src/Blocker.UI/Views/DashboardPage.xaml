<Page x:Class="Blocker.UI.Views.DashboardPage"
             x:ClassModifier="internal"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:rd="clr-namespace:Blocker.UI.Controls.Rendering;assembly=Blocker.UI.Controls"
      xmlns:bh="clr-namespace:Blocker.UI.Behaviors"
      Title="Session" Background="Transparent">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="{StaticResource Blocker.Thickness.Page}">
                <Border Style="{DynamicResource Blocker.SectionDivider}" Padding="0,0,0,16" Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource Blocker.Text.Title}" Text="Session" VerticalAlignment="Center" />
                        <ContentControl Style="{DynamicResource Blocker.InfoBadge}" Margin="8,-1,0,0">
                            <ContentControl.ToolTip>
                                <ToolTip Style="{DynamicResource Blocker.InfoTip.ToolTip}"
                                         Content="Only allowlisted apps and websites stay open until the timer reaches zero." />
                            </ContentControl.ToolTip>
                        </ContentControl>
                    </StackPanel>
                </Border>

                <!-- Idle: one action, one shortcut. -->
                <StackPanel HorizontalAlignment="Center" Margin="0,32,0,24"
                            Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisible}}">
                    <TextBlock Style="{DynamicResource Blocker.Text.Clock}" Text="{Binding ClockText}" HorizontalAlignment="Center" Margin="0,0,0,24" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{DynamicResource Blocker.Button.Primary}" Command="{Binding StartSessionCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 0,0 L 8,4.5 L 0,9 Z" Fill="{DynamicResource Blocker.Text.OnAccent}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Start session" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Margin="12,0,0,0" Style="{DynamicResource Blocker.Button.SecondaryPill}"
                                Command="{Binding OpenAllowlistCommand}" Content="Allowlist" />
                    </StackPanel>
                </StackPanel>

                <!-- Running: clock, progress, pass countdown and the exits. -->
                <StackPanel HorizontalAlignment="Center" Margin="0,32,0,24"
                            Visibility="{Binding IsSessionRunning, Converter={StaticResource BoolToVisible}}">
                    <TextBlock Style="{DynamicResource Blocker.Text.Clock}" Text="{Binding ClockText}" HorizontalAlignment="Center"
                               AutomationProperties.Name="Time remaining in session" />
                    <ProgressBar Width="460" Height="4" Margin="0,20,0,28" Minimum="0" Maximum="1"
                                 Value="{Binding ProgressRatio, Mode=OneWay}" Background="#16181F"
                                 Foreground="{DynamicResource Blocker.Accent.Bar}" BorderThickness="0" />

                    <Border Margin="0,0,0,24" Padding="14,10" CornerRadius="4" BorderThickness="1" HorizontalAlignment="Center"
                            Visibility="{Binding IsPassActive, Converter={StaticResource BoolToVisible}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Blocker.Bg.Raised}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Blocker.Border.Strong}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPassWarning}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Blocker.Warning.Soft}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Blocker.Warning}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding PassClockText}" Style="{DynamicResource Blocker.Text.Mono}" FontSize="16"
                                       VerticalAlignment="Center" AutomationProperties.Name="Emergency pass time remaining" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Blocker.Text.Caption}">
                                        <Setter Property="Text" Value="Blocking is paused." />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPassWarning}" Value="True">
                                                <Setter Property="Text" Value="Blocking resumes in under a minute." />
                                                <Setter Property="Foreground" Value="{DynamicResource Blocker.Warning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{DynamicResource Blocker.Button.Warning}" Command="{Binding UseEmergencyPassCommand}" Content="Emergency exit" />
                        <StackPanel Orientation="Horizontal" Margin="18,0" VerticalAlignment="Center">
                            <TextBlock Style="{DynamicResource Blocker.Text.Body}" VerticalAlignment="Center">
                                <Run Text="{Binding PassesLeftText, Mode=OneWay}" />
                                <Run Text="{Binding PassLengthText, Mode=OneWay}" />
                            </TextBlock>
                            <ContentControl Style="{DynamicResource Blocker.InfoBadge}" Margin="7,-1,0,0">
                                <ContentControl.ToolTip>
                                    <ToolTip Style="{DynamicResource Blocker.InfoTip.ToolTip}"
                                             Content="An emergency pass pauses blocking for a short time. Blocking resumes automatically when it expires." />
                                </ContentControl.ToolTip>
                            </ContentControl>
                        </StackPanel>
                        <Button Style="{DynamicResource Blocker.Button.GhostPill}" Command="{Binding EnterBreakGlassCodeCommand}" Content="Break-glass code" />
                    </StackPanel>
                    <TextBlock Style="{DynamicResource Blocker.Text.Caption}" Margin="0,12,0,0" HorizontalAlignment="Center"
                               TextAlignment="Center" Text="{Binding EmergencyHint}"
                               Visibility="{Binding EmergencyHint, Converter={StaticResource HasTextToVisible}}" />
                </StackPanel>

                <!-- Plugin widgets the user chose. -->
                <Grid Margin="0,24,0,16" Visibility="{Binding Board.HasAvailable, Converter={StaticResource BoolToVisible}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{DynamicResource Blocker.Text.CardTitle}" Text="Widgets" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{DynamicResource Blocker.Button.Subtle}" Padding="10,0" MinWidth="40"
                                Command="{Binding Board.Picker.OpenCommand}" ToolTip="Add widgets"
                                AutomationProperties.Name="Add widgets">
                            <ui:SymbolIcon Symbol="Add24" />
                        </Button>
                        <Button Style="{DynamicResource Blocker.Button.Subtle}" Padding="10,0" Margin="4,0,0,0"
                                Command="{Binding Board.ToggleEditCommand}" ToolTip="Rearrange or remove widgets"
                                AutomationProperties.Name="Edit widgets">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,8,0">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Symbol" Value="Edit24" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Board.IsEditing}" Value="True">
                                                    <Setter Property="Symbol" Value="Checkmark24" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Edit" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Board.IsEditing}" Value="True">
                                                    <Setter Property="Text" Value="Done" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <TextBlock Style="{DynamicResource Blocker.Text.Caption}" Margin="0,0,0,16" Text="{Binding WidgetsError}"
                           Visibility="{Binding WidgetsError, Converter={StaticResource HasTextToVisible}}" />
                <TextBlock Style="{DynamicResource Blocker.Text.Caption}" Margin="0,0,0,16" Foreground="{DynamicResource Blocker.Warning}"
                           Text="{Binding Board.LayoutError}"
                           Visibility="{Binding Board.LayoutError, Converter={StaticResource HasTextToVisible}}" />

                <!-- Empty board: invite the user to add a first widget. -->
                <Button Style="{DynamicResource Blocker.Button.Subtle}" HorizontalAlignment="Left" Width="300" Height="120" Padding="0"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        Command="{Binding Board.Picker.OpenCommand}" AutomationProperties.Name="Add a widget"
                        Visibility="{Binding Board.ShowEmptyState, Converter={StaticResource BoolToVisible}}">
                    <Grid>
                        <Rectangle Stroke="{DynamicResource Blocker.Border.Strong}" StrokeThickness="1" StrokeDashArray="4 4" RadiusX="4" RadiusY="4" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Add24" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Style="{DynamicResource Blocker.Text.Body}" Text="Add a widget" HorizontalAlignment="Center" />
                            <TextBlock Style="{DynamicResource Blocker.Text.Caption}" Text="Choose what to show here." HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Button>

                <ItemsControl ItemsSource="{Binding Board.Items}" Visibility="{Binding Board.HasItems, Converter={StaticResource BoolToVisible}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="{Binding Width}" Margin="0,0,16,16" VerticalAlignment="Top">
                                <rd:UiNodeView Node="{Binding Contribution.Node}"
                                               bh:UiNodeActions.Contribution="{Binding Contribution}"
                                               bh:UiNodeActions.Command="{Binding DataContext.SendWidgetActionCommand, RelativeSource={RelativeSource AncestorType=Page}}">
                                    <rd:UiNodeView.Style>
                                        <Style TargetType="rd:UiNodeView">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <Setter Property="IsHitTestVisible" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </rd:UiNodeView.Style>
                                </rd:UiNodeView>

                                <!-- Edit mode: dashed outline and the card's own controls. -->
                                <Grid Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisible}}">
                                    <Rectangle Stroke="{DynamicResource Blocker.Accent.Bar}" StrokeThickness="1" StrokeDashArray="4 3"
                                               RadiusX="4" RadiusY="4" IsHitTestVisible="False" />
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="2" CornerRadius="4" BorderThickness="1"
                                            Background="{DynamicResource Blocker.Bg.Raised}" BorderBrush="{DynamicResource Blocker.Border.Strong}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{DynamicResource Blocker.Button.Subtle}" MinHeight="32" MinWidth="32" Padding="0"
                                                    Command="{Binding DataContext.Board.MoveEarlierCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}" ToolTip="Move earlier" AutomationProperties.Name="Move widget earlier">
                                                <ui:SymbolIcon Symbol="ArrowLeft24" />
                                            </Button>
                                            <Button Style="{DynamicResource Blocker.Button.Subtle}" MinHeight="32" MinWidth="32" Padding="0"
                                                    Command="{Binding DataContext.Board.MoveLaterCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}" ToolTip="Move later" AutomationProperties.Name="Move widget later">
                                                <ui:SymbolIcon Symbol="ArrowRight24" />
                                            </Button>
                                            <Button Style="{DynamicResource Blocker.Button.Subtle}" MinHeight="32" Padding="8,0" FontSize="12"
                                                    Command="{Binding DataContext.Board.ToggleSizeCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}" ToolTip="Change widget size" AutomationProperties.Name="Change widget size">
                                                <TextBlock Text="{Binding ToggleSizeText}" />
                                            </Button>
                                            <Button Style="{DynamicResource Blocker.Button.Subtle}" MinHeight="32" MinWidth="32" Padding="0"
                                                    Foreground="{DynamicResource Blocker.Danger}"
                                                    Command="{Binding DataContext.Board.RemoveCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}" ToolTip="Remove widget" AutomationProperties.Name="Remove widget">
                                                <ui:SymbolIcon Symbol="Dismiss24" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Widget picker: bottom sheet over a dimmed page. -->
        <Grid x:Name="PickerOverlay" DataContext="{Binding Board.Picker}" KeyboardNavigation.TabNavigation="Cycle"
              Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisible}}">
            <Grid.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
            </Grid.InputBindings>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.25*" />
                <RowDefinition Height="0.75*" />
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="2" Background="#B3000000" Cursor="Arrow">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseCommand}" />
                </Border.InputBindings>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <Border Grid.Row="1" MaxWidth="760" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="24,12,24,0"
                    Background="{DynamicResource Blocker.Bg.Card}" BorderBrush="{DynamicResource Blocker.Border.Strong}"
                    BorderThickness="1,1,1,0" CornerRadius="16,16,0,0" SnapsToDevicePixels="True"
                    AutomationProperties.Name="Add widgets">
                <Border.RenderTransform>
                    <TranslateTransform />
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             From="64" To="0" Duration="0:0:0.24">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Grab handle, as on an Android bottom sheet. -->
                    <Border Width="40" Height="4" CornerRadius="2" HorizontalAlignment="Center" Margin="0,0,0,12"
                            Background="{DynamicResource Blocker.Border.Strong}" />

                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{DynamicResource Blocker.Text.Subtitle}" Text="Add widgets" />
                            <TextBlock Style="{DynamicResource Blocker.Text.Caption}" Text="Pick a widget to show on your Session page." />
                        </StackPanel>
                        <Button x:Name="PickerClose" Grid.Column="1" Style="{DynamicResource Blocker.Button.Subtle}" Padding="10,0" MinWidth="40"
                                Command="{Binding CloseCommand}" ToolTip="Close (Esc)" AutomationProperties.Name="Close widget picker">
                            <ui:SymbolIcon Symbol="Dismiss24" />
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Groups}" Margin="0,0,0,24">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <Path Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"
                                                  Fill="{DynamicResource Blocker.Text.Secondary}" Data="{Binding Icon}"
                                                  Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisible}}" />
                                            <TextBlock Style="{DynamicResource Blocker.Text.Caption}" FontWeight="SemiBold" Text="{Binding Title}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Entries}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Width="324" Margin="0,0,16,16" Padding="12" VerticalAlignment="Top"
                                                            Style="{DynamicResource Blocker.Button.Subtle}"
                                                            Background="{DynamicResource Blocker.Bg.Raised}" BorderBrush="{DynamicResource Blocker.Border.Subtle}"
                                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                                                            Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                                                            CommandParameter="{Binding}"
                                                            AutomationProperties.Name="{Binding Contribution.Title, StringFormat='Add {0}'}">
                                                        <StackPanel>
                                                            <!-- Live, non-interactive preview scaled down to fit. -->
                                                            <Border Background="{DynamicResource Blocker.Bg.Canvas}" CornerRadius="4" Padding="8" Height="180" ClipToBounds="True">
                                                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top">
                                                                    <Grid Width="300">
                                                                        <rd:UiNodeView Node="{Binding Contribution.Node}" IsHitTestVisible="False" />
                                                                    </Grid>
                                                                </Viewbox>
                                                            </Border>
                                                            <Grid Margin="0,12,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Style="{DynamicResource Blocker.Text.CardTitle}" Text="{Binding Contribution.Title}" />
                                                                    <TextBlock Style="{DynamicResource Blocker.Text.Caption}" Text="{Binding SizeLabel}" />
                                                                </StackPanel>
                                                                <Border Grid.Column="1" Style="{StaticResource App.Chip}" Margin="12,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock>
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource App.ChipText}">
                                                                                <Setter Property="Text" Value="Add" />
                                                                                <Setter Property="Foreground" Value="{DynamicResource Blocker.Text.Primary}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsAdded}" Value="True">
                                                                                        <Setter Property="Text" Value="Added" />
                                                                                        <Setter Property="Foreground" Value="{DynamicResource Blocker.Text.Secondary}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
