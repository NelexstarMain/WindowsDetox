<Page x:Class="Blocker.UI.Views.PluginsPage"
      ScrollViewer.CanContentScroll="True"
             x:ClassModifier="internal"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Blocker.UI.ViewModels"
      Title="Plugins" Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource Blocker.Thickness.Page}">
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{DynamicResource Blocker.Text.Title}" Text="Plugins" VerticalAlignment="Center" />
                    <ContentControl Style="{DynamicResource Blocker.InfoBadge}" Margin="8,-1,0,0">
                        <ContentControl.ToolTip>
                            <ToolTip Style="{DynamicResource Blocker.InfoTip.ToolTip}"
                                     Content="Download the starter template, describe what you want to an AI agent, then install the finished .zip here. Blocker tests it before it is installed." />
                        </ContentControl.ToolTip>
                    </ContentControl>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{DynamicResource Blocker.Button.SecondaryPill}" Command="{Binding DownloadTemplateCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowDownload24" Margin="0,0,8,0" />
                            <TextBlock Text="Download starter template (.zip)" />
                        </StackPanel>
                    </Button>
                    <Button Margin="8,0,0,0" Style="{DynamicResource Blocker.Button.Primary}" Command="{Binding InstallCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowUpload24" Margin="0,0,8,0" />
                            <TextBlock Text="Install plugin (.zip)" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Margin="0,0,0,16" Padding="16,8" CornerRadius="4" BorderThickness="1"
                    Background="{DynamicResource Blocker.Warning.Soft}" BorderBrush="{DynamicResource Blocker.Warning}"
                    Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisible}}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="LockClosed24" Foreground="{DynamicResource Blocker.Warning}" Margin="0,0,8,0" />
                    <TextBlock Style="{DynamicResource Blocker.Text.Body}" Foreground="{DynamicResource Blocker.Text.Primary}"
                               Text="{Binding LockMessage}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <TextBlock Style="{DynamicResource Blocker.Text.Caption}" Margin="0,0,0,16" Text="{Binding AdminNote}" />
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,16" Foreground="{DynamicResource Blocker.Accent}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" AutomationProperties.Name="Working" />

            <TextBlock Style="{DynamicResource Blocker.Text.Body}" Foreground="{DynamicResource Blocker.Text.Secondary}"
                       Text="No plugins installed."
                       Visibility="{Binding HasNoPlugins, Converter={StaticResource BoolToVisible}}" />

            <ItemsControl ItemsSource="{Binding Plugins}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PluginItemViewModel}">
                        <Border Style="{DynamicResource Blocker.SectionDivider}" Padding="0,0,0,20" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{DynamicResource Blocker.Text.CardTitle}" Text="{Binding Name}" VerticalAlignment="Center" />
                                        <Border VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource App.Chip}">
                                                    <Setter Property="Margin" Value="12,0,0,0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="Enabled">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Blocker.Accent}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Faulted">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Blocker.Danger}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StateLabel}" Style="{StaticResource App.ChipText}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{DynamicResource Blocker.Text.Caption}" Margin="0,4,0,8">
                                        <Run Text="Version" /> <Run Text="{Binding Version, Mode=OneWay}" />
                                        <Run Text=" by " /><Run Text="{Binding Author, Mode=OneWay}" />
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding Capabilities}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:CapabilityChip}">
                                                <Border>
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource App.Chip}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPrivacySensitive}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Blocker.Warning.Soft}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource Blocker.Warning}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="Warning24" FontSize="12" Margin="0,0,4,0" Foreground="{DynamicResource Blocker.Warning}"
                                                                       Visibility="{Binding IsPrivacySensitive, Converter={StaticResource BoolToVisible}}" />
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource App.ChipText}" ToolTip="{Binding Name}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{DynamicResource Blocker.Text.Caption}" Foreground="{DynamicResource Blocker.Warning}"
                                               Text="Privacy: this plugin can read the titles of the windows you use."
                                               Visibility="{Binding HasPrivacySensitiveCapability, Converter={StaticResource BoolToVisible}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Style="{DynamicResource Blocker.Button.Secondary}" Content="{Binding ToggleLabel}" MinWidth="88"
                                            Command="{Binding DataContext.ToggleEnabledCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Margin="8,0,0,0" Style="{DynamicResource Blocker.Button.Subtle}" Content="Remove"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
