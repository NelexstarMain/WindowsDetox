<ui:FluentWindow x:Class="Blocker.UI.Views.MainWindow"
             x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:Blocker.UI.Views"
                 Title="WindowsDetox" Width="1100" Height="700" MinWidth="900" MinHeight="600"
                 Icon="pack://application:,,,/Assets/app.ico"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 Background="{DynamicResource Blocker.Bg.Canvas}"
                 Foreground="{DynamicResource Blocker.Text.Primary}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="214" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Full-height sidebar surface; the navigation pane sits on top of it. -->
        <Border Grid.Column="0" Grid.RowSpan="3" Background="{DynamicResource Blocker.Bg.Canvas}"
                BorderBrush="{DynamicResource Blocker.Border.Subtle}" BorderThickness="0,0,1,0" />

        <!-- Workspace canvas with a faint logo watermark. -->
        <Grid Grid.Column="1" Grid.RowSpan="3" Background="{DynamicResource Blocker.Bg.Canvas}" ClipToBounds="True">
            <Path Data="{StaticResource Blocker.Logo.Geometry}" Fill="{DynamicResource Blocker.Logo.Brush}" Opacity="0.025"
                  Width="430" Height="430" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Margin="0,0,-50,-70" IsHitTestVisible="False" />
        </Grid>

        <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,4,12,0">
            <Path Data="{StaticResource Blocker.Logo.Geometry}" Fill="{StaticResource Blocker.Nav.Muted}"
                  Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" />
            <TextBlock Text="Windows Detox" FontFamily="{DynamicResource Blocker.Font.Ui}" FontSize="13.5" FontWeight="Medium"
                       Foreground="{StaticResource Blocker.Nav.Muted}" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <Border Grid.Column="1" Grid.Row="1" Padding="24,8" Background="{DynamicResource Blocker.Warning.Soft}"
                BorderBrush="{DynamicResource Blocker.Warning}" BorderThickness="0,0,0,1"
                Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVisible}}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="PlugConnected24" Foreground="{DynamicResource Blocker.Warning}" Margin="0,0,8,0" />
                <TextBlock Style="{DynamicResource Blocker.Text.Body}" Foreground="{DynamicResource Blocker.Text.Primary}"
                           Text="{Binding DisconnectedMessage}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <ui:NavigationView x:Name="RootNavigation" Grid.Row="2" Grid.ColumnSpan="2"
                           PaneDisplayMode="Left" OpenPaneLength="214"
                           IsBackButtonVisible="Collapsed" IsPaneToggleVisible="False"
                           Transition="FadeIn" TransitionDuration="180"
                           Background="Transparent">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Style="{StaticResource Blocker.NavItem}" Content="Session" TargetPageType="{x:Type views:DashboardPage}">
                    <ui:NavigationViewItem.Icon>
                        <views:LineIcon Data="M12 3.4 A8.6 8.6 0 1 1 3.4 12 M13.2 12 A1.2 1.2 0 1 1 10.8 12 A1.2 1.2 0 1 1 13.2 12 Z" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Style="{StaticResource Blocker.NavItem}" Content="Allowlist" TargetPageType="{x:Type views:AllowlistPage}">
                    <ui:NavigationViewItem.Icon>
                        <views:LineIcon Data="M5 7 H19 M5 12 H15.5 M5 17 H12" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Style="{StaticResource Blocker.NavItem}" Content="Session setup" TargetPageType="{x:Type views:SetupPage}">
                    <ui:NavigationViewItem.Icon>
                        <views:LineIcon Data="M12 3.2 L19 6 V11.6 C19 15.9 16 19.2 12 20.8 C8 19.2 5 15.9 5 11.6 V6 Z" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Style="{StaticResource Blocker.NavItem}" Content="Plugins" TargetPageType="{x:Type views:PluginsPage}">
                    <ui:NavigationViewItem.Icon>
                        <views:LineIcon Data="M4.5 4.5 H12 V12 H4.5 Z M20 15.5 A4.5 4.5 0 1 1 11 15.5 A4.5 4.5 0 1 1 20 15.5 Z" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Style="{StaticResource Blocker.NavItem}" Content="Settings" TargetPageType="{x:Type views:SettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <views:LineIcon Data="M12 3.3 L19.5 7.6 V16.4 L12 20.7 L4.5 16.4 V7.6 Z M14.6 12 A2.6 2.6 0 1 1 9.4 12 A2.6 2.6 0 1 1 14.6 12 Z" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <!-- Window controls and drag area over the workspace column only, so nothing cuts across the sidebar. -->
        <ui:TitleBar Grid.Column="1" Grid.Row="0" Title="" Height="36" VerticalAlignment="Top" Background="Transparent" />

        <!-- Hosts for dialogs and snackbars; wired to their services by the window. -->
        <ui:ContentDialogHost x:Name="RootContentDialog" Grid.ColumnSpan="2" Grid.RowSpan="3" />
        <ui:SnackbarPresenter x:Name="RootSnackbar" Grid.ColumnSpan="2" Grid.RowSpan="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16" />
    </Grid>
</ui:FluentWindow>
