<Page x:Class="Blocker.UI.Views.AppLimitsPage"
      ScrollViewer.CanContentScroll="True"
             x:ClassModifier="internal"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:rd="clr-namespace:Blocker.UI.Controls.Rendering;assembly=Blocker.UI.Controls"
      xmlns:vm="clr-namespace:Blocker.UI.ViewModels"
      Title="App limits" Background="Transparent">
    <Page.Resources>
        <!-- A glyph that shows only for one state of a list item. -->
        <Style x:Key="App.Glyph.ScheduledBlock" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="ScheduledBlock">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="App.Glyph.PoolExhausted" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="PoolExhausted">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="App.Glyph.SessionControlled" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="SessionControlled">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="App.Glyph.Allowed" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Allowed">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One step of the precedence strip in the header: lit when it is the one deciding about the app right now. -->
        <Style x:Key="App.Step" TargetType="ContentControl">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="{DynamicResource Blocker.Text.Muted}" />
            <Setter Property="Background" Value="{DynamicResource Blocker.Bg.Raised}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="App.Step.Session" TargetType="ContentControl" BasedOn="{StaticResource App.Step}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Editing.State}" Value="SessionControlled">
                    <Setter Property="Background" Value="{DynamicResource Blocker.Accent.Soft}" />
                    <Setter Property="Foreground" Value="{DynamicResource Blocker.Accent.Text}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="App.Step.Block" TargetType="ContentControl" BasedOn="{StaticResource App.Step}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Editing.State}" Value="ScheduledBlock">
                    <Setter Property="Background" Value="{DynamicResource Blocker.Accent.Soft}" />
                    <Setter Property="Foreground" Value="{DynamicResource Blocker.Accent.Text}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="App.Step.Pool" TargetType="ContentControl" BasedOn="{StaticResource App.Step}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Editing.State}" Value="PoolExhausted">
                    <Setter Property="Background" Value="{DynamicResource Blocker.Accent.Soft}" />
                    <Setter Property="Foreground" Value="{DynamicResource Blocker.Accent.Text}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <!-- The navigation host measures pages without a height limit, so the page takes the visible height itself: the list and the editor
         scroll on their own and Save stays in view. -->
    <Border Padding="{StaticResource Blocker.Thickness.Page}"
            Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Margin="0,0,0,20" Style="{DynamicResource Blocker.Text.Title}" Text="App limits" />

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Apps: the ones with limits first; an icon on the right shows what decides about each right now. -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ui:TextBox Grid.Row="0" PlaceholderText="Search apps" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                AutomationProperties.Name="Search apps" />
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <ListBox x:Name="AppList" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="Apps">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" Margin="10,8,0,6" FontSize="11" FontWeight="SemiBold"
                                                       Style="{DynamicResource Blocker.Text.Caption}" Foreground="{DynamicResource Blocker.Text.Muted}" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Margin" Value="0,0,10,2" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding App.DisplayName}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Row" Padding="10,8" CornerRadius="{StaticResource Blocker.Radius.Control}"
                                                        BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Blocker.Logo.Brush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Blocker.Bg.Card}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Blocker.Accent.Soft}" />
                                                        <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Blocker.Accent}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AppLimitItemViewModel}">
                                    <Grid Background="Transparent" ToolTip="{Binding StatusText}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="22" />
                                        </Grid.ColumnDefinitions>
                                        <Image Width="24" Height="24" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                                               Source="{Binding App.IconPng, Converter={StaticResource PngToMutedIcon}}" />
                                        <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding App.DisplayName}" Style="{DynamicResource Blocker.Text.Body}" FontSize="13"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <ProgressBar Minimum="0" Maximum="1" Height="3" Margin="0,5,0,0"
                                                         Value="{Binding UsageFraction, Mode=OneWay}"
                                                         Visibility="{Binding HasPool, Converter={StaticResource BoolToVisible}}">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource App.Bar}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="PoolExhausted">
                                                                <Setter Property="Foreground" Value="{DynamicResource Blocker.Text.Muted}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                        </StackPanel>
                                        <Grid Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <ui:SymbolIcon Style="{StaticResource App.Glyph.ScheduledBlock}" Symbol="LockClosed24" FontSize="15" Foreground="{DynamicResource Blocker.Accent.Text}" />
                                            <ui:SymbolIcon Style="{StaticResource App.Glyph.PoolExhausted}" Symbol="Hourglass24" FontSize="15" Foreground="{DynamicResource Blocker.Text.Primary}" />
                                            <ui:SymbolIcon Style="{StaticResource App.Glyph.SessionControlled}" Symbol="ShieldLock24" FontSize="15" Foreground="{DynamicResource Blocker.Text.Secondary}" />
                                            <Ellipse Style="{StaticResource App.Glyph.Allowed}" Width="7" Height="7" Fill="{DynamicResource Blocker.Accent.Text}" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding HasNoApps, Converter={StaticResource BoolToVisible}}">
                            <ui:ProgressRing IsIndeterminate="True" Width="32" Height="32"
                                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisible}}" />
                            <TextBlock Style="{DynamicResource Blocker.Text.Body}" TextAlignment="Center" Foreground="{DynamicResource Blocker.Text.Muted}"
                                       Text="No apps"
                                       Visibility="{Binding IsScanning, Converter={StaticResource BoolToCollapsed}}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <Border Grid.Column="1" Width="1" Margin="24,0" Background="{DynamicResource Blocker.Border.Subtle}" />

                <!-- Editor of the selected app. -->
                <ui:SymbolIcon Grid.Column="2" Symbol="Hourglass24" FontSize="44" Opacity="0.25" Foreground="{DynamicResource Blocker.Text.Muted}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               Visibility="{Binding HasNoEditing, Converter={StaticResource BoolToVisible}}" />
                <Grid Grid.Column="2" Visibility="{Binding HasEditing, Converter={StaticResource BoolToVisible}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Width="36" Height="36" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                                       Source="{Binding Editing.App.IconPng, Converter={StaticResource PngToActiveIcon}}" />
                                <TextBlock Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center" Style="{DynamicResource Blocker.Text.CardTitle}" FontSize="20"
                                           Text="{Binding Editing.App.DisplayName}" ToolTip="{Binding Editing.StatusText}" />
                                <!-- What decides, in order: a running session, then the scheduled block, then the time pool. The one deciding right now is lit. -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding Editing.StatusText}">
                                    <ContentControl Style="{StaticResource App.Step.Session}">
                                        <ui:SymbolIcon Symbol="ShieldLock24" FontSize="15" />
                                    </ContentControl>
                                    <ui:SymbolIcon Symbol="ChevronRight12" Margin="4,0" FontSize="10" Foreground="{DynamicResource Blocker.Text.Muted}" />
                                    <ContentControl Style="{StaticResource App.Step.Block}">
                                        <ui:SymbolIcon Symbol="LockClosed24" FontSize="15" />
                                    </ContentControl>
                                    <ui:SymbolIcon Symbol="ChevronRight12" Margin="4,0" FontSize="10" Foreground="{DynamicResource Blocker.Text.Muted}" />
                                    <ContentControl Style="{StaticResource App.Step.Pool}">
                                        <ui:SymbolIcon Symbol="Hourglass24" FontSize="15" />
                                    </ContentControl>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ListBox x:Name="EditorTabs" Style="{StaticResource App.SegmentedList}" SelectedIndex="0"
                                         AutomationProperties.Name="Limit type">
                                    <ListBoxItem AutomationProperties.Name="Scheduled block"
                                                 ToolTip="The app cannot run in the marked times, every week. Drag on the grid to add a block; drag a block to move it or its bottom edge to resize it.">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="LockClosed24" FontSize="15" Margin="0,0,8,0" />
                                            <TextBlock Text="Block" />
                                        </StackPanel>
                                    </ListBoxItem>
                                    <ListBoxItem AutomationProperties.Name="Time pool"
                                                 ToolTip="How long the app may be used when it is not blocked. The count restarts at midnight, or on Monday for a weekly pool.">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Hourglass24" FontSize="15" Margin="0,0,8,0" />
                                            <TextBlock Text="Time pool" />
                                        </StackPanel>
                                    </ListBoxItem>
                                </ListBox>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=EditorTabs}" Value="1">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock VerticalAlignment="Center" Margin="0,0,10,0" Style="{DynamicResource Blocker.Text.MonoSmall}"
                                               Text="{Binding SelectedBlockText}"
                                               Visibility="{Binding SelectedBlockText, Converter={StaticResource HasTextToVisible}}" />
                                    <Button Style="{DynamicResource Blocker.Button.SecondaryCompact}" Content="Remove block"
                                            Command="{Binding RemoveSelectedBlockCommand}" />
                                </StackPanel>
                            </Grid>

                            <Border Margin="0,16,0,0" Padding="16,10" CornerRadius="6" BorderThickness="1"
                                    Background="{DynamicResource Blocker.Accent.Soft}" BorderBrush="{DynamicResource Blocker.Accent}"
                                    Visibility="{Binding ErrorMessage, Converter={StaticResource HasTextToVisible}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Info24" Foreground="{DynamicResource Blocker.Accent.Text}" Margin="0,0,10,0" VerticalAlignment="Top" />
                                    <TextBlock Style="{DynamicResource Blocker.Text.Body}" Text="{Binding ErrorMessage}" MaxWidth="560" />
                                </StackPanel>
                            </Border>

                            <!-- Scheduled block -->
                            <StackPanel Margin="0,16,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=EditorTabs}" Value="1">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                    <WrapPanel Margin="0,0,0,12">
                                        <Button Margin="0,0,8,0" Style="{DynamicResource Blocker.Button.SecondaryCompact}" Content="Work hours (Mon–Fri 9–17)"
                                                Command="{Binding ApplyPresetCommand}" CommandParameter="work" />
                                        <Button Margin="0,0,8,0" Style="{DynamicResource Blocker.Button.SecondaryCompact}" Content="Evenings (18–23)"
                                                Command="{Binding ApplyPresetCommand}" CommandParameter="evenings" />
                                        <Button Style="{DynamicResource Blocker.Button.SubtleCompact}" Content="Clear"
                                                Command="{Binding ApplyPresetCommand}" CommandParameter="clear" />
                                    </WrapPanel>
                                    <rd:UiNodeView x:Name="GridView" Node="{Binding ScheduleNode}" ActionInvoked="OnGridAction" />
                            </StackPanel>

                            <!-- Time pool -->
                            <StackPanel Margin="0,16,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=EditorTabs}" Value="1">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ListBox Style="{StaticResource App.SegmentedList}" SelectedIndex="{Binding BudgetModeIndex, Mode=TwoWay}"
                                         AutomationProperties.Name="Time pool mode">
                                    <ListBoxItem Content="Off" />
                                    <ListBoxItem Content="Every day" />
                                    <ListBoxItem Content="Each day" />
                                    <ListBoxItem Content="Per week" />
                                </ListBox>

                                <StackPanel Margin="0,16,0,0" Orientation="Horizontal" Visibility="{Binding IsDailyMode, Converter={StaticResource BoolToVisible}}">
                                    <StackPanel>
                                        <TextBlock Style="{DynamicResource Blocker.Text.Caption}" Text="Hours" Margin="0,0,0,4" />
                                        <ui:NumberBox Width="110" Minimum="0" Maximum="24" SmallChange="1" MaxDecimalPlaces="0"
                                                      Value="{Binding DailyHours, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="12,0,0,0">
                                        <TextBlock Style="{DynamicResource Blocker.Text.Caption}" Text="Minutes" Margin="0,0,0,4" />
                                        <ui:NumberBox Width="110" Minimum="0" Maximum="59" SmallChange="5" MaxDecimalPlaces="0"
                                                      Value="{Binding DailyMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Margin="0,16,0,0" Orientation="Horizontal" Visibility="{Binding IsWeeklyMode, Converter={StaticResource BoolToVisible}}">
                                    <StackPanel>
                                        <TextBlock Style="{DynamicResource Blocker.Text.Caption}" Text="Hours" Margin="0,0,0,4" />
                                        <ui:NumberBox Width="110" Minimum="0" Maximum="168" SmallChange="1" MaxDecimalPlaces="0"
                                                      Value="{Binding WeeklyHours, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="12,0,0,0">
                                        <TextBlock Style="{DynamicResource Blocker.Text.Caption}" Text="Minutes" Margin="0,0,0,4" />
                                        <ui:NumberBox Width="110" Minimum="0" Maximum="59" SmallChange="5" MaxDecimalPlaces="0"
                                                      Value="{Binding WeeklyMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Margin="0,16,0,0" Visibility="{Binding IsPerWeekdayMode, Converter={StaticResource BoolToVisible}}">
                                    <TextBlock Style="{DynamicResource Blocker.Text.Caption}" Text="Minutes" Margin="0,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding WeekdayBudgets}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:WeekdayBudgetViewModel}">
                                                <StackPanel Margin="0,0,8,8">
                                                    <TextBlock Style="{DynamicResource Blocker.Text.Caption}" Text="{Binding Label}" Margin="2,0,0,4"
                                                               Foreground="{DynamicResource Blocker.Text.Muted}" />
                                                    <ui:NumberBox Width="72" Minimum="0" Maximum="1440" SmallChange="15" MaxDecimalPlaces="0"
                                                                  SpinButtonPlacementMode="Hidden" AutomationProperties.Name="{Binding Label}"
                                                                  Value="{Binding Minutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <Grid Margin="0,20,0,0" Width="360" HorizontalAlignment="Left" Visibility="{Binding HasUsage, Converter={StaticResource BoolToVisible}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar Style="{StaticResource App.Bar}" Minimum="0" Maximum="1" Height="6" VerticalAlignment="Center"
                                                 Value="{Binding UsageFraction, Mode=OneWay}" />
                                    <TextBlock Grid.Column="1" Margin="12,0,0,0" Style="{DynamicResource Blocker.Text.MonoSmall}" Text="{Binding UsageText}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1" Margin="0,12,12,0" Padding="0,16,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Blocker.Border.Subtle}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{DynamicResource Blocker.Button.Primary}" Content="Save" Command="{Binding SaveCommand}" MinWidth="96" />
                            <Button Margin="8,0,0,0" Style="{DynamicResource Blocker.Button.Secondary}" Content="Remove rule" Command="{Binding RemoveRuleCommand}" />
                            <Ellipse Margin="16,0,0,0" Width="8" Height="8" Fill="{DynamicResource Blocker.Accent.Text}" ToolTip="Unsaved changes"
                                     Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisible}}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Page>
