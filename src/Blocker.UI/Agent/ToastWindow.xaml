<Window x:Class="Blocker.UI.Agent.ToastWindow"
             x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mb="clr-namespace:Blocker.UI.Controls.Metaballs;assembly=Blocker.UI.Controls"
        Title="WindowsDetox" Width="360" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Background="{DynamicResource Blocker.Bg.Base}">
    <!-- Always-on-top notification in the bottom-right corner. The agent positions it and closes it when the view model expires. -->
    <mb:MetaballHost>
        <Border Margin="8" Padding="16,14" CornerRadius="12" BorderThickness="1" mb:Metaball.IsBody="True">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Blocker.CardBorder}">
                    <Setter Property="BorderBrush" Value="{DynamicResource Blocker.Border.Strong}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Blocker.Warning}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{DynamicResource Blocker.Text.Subtitle}" Text="{Binding Title}" TextWrapping="Wrap" />
                    <TextBlock Style="{DynamicResource Blocker.Text.Body}" Margin="0,4,0,0" Text="{Binding Message}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                           Style="{DynamicResource Blocker.Text.Mono}" FontSize="28"
                           Foreground="{DynamicResource Blocker.Warning}" Text="{Binding CountdownText}"
                           Visibility="{Binding HasCountdown, Converter={StaticResource BoolToVisible}}"
                           AutomationProperties.Name="Time until blocking resumes" />
            </Grid>
        </Border>
    </mb:MetaballHost>
</Window>
