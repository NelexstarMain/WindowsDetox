<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- No console: a console-subsystem process makes Windows start conhost, which the one-process job limit then kills (STATUS_DLL_INIT_FAILED, C0000142). -->
    <OutputType>WinExe</OutputType>
    <RootNamespace>Blocker.PluginHost</RootNamespace>
    <AssemblyName>Blocker.PluginHost</AssemblyName>
    <Description>Sandboxed process that compiles, tests and runs plugins; speaks the host.* IPC protocol with Blocker.Service.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Blocker.Core\Blocker.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
</Project>
